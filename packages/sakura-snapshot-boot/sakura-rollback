#!/bin/sh
# Roll the live root subvolume back to a snapshot.
#
# Must run with the root subvolume NOT mounted -- from the recovery initramfs,
# with the btrfs top-level mounted somewhere. Refusing to run otherwise is
# deliberate: renaming a mounted root subvolume is the kind of thing that
# appears to work and then corrupts a boot two reboots later.
#
#   sakura-rollback <top-level-mount> <snapshot-number>
set -eu

. /usr/lib/sakura/snapshot-boot/lib.sh

TOP="${1:?usage: sakura-rollback <top-level-mount> <snapshot-number>}"
NUM="${2:?usage: sakura-rollback <top-level-mount> <snapshot-number>}"

SNAP="$TOP/$SAKURA_SNAPSHOT_SUBVOL/$NUM/snapshot"
ROOT="$TOP/$SAKURA_ROOT_SUBVOL"

[ -d "$SNAP" ] || { echo "snapshot $NUM does not exist at $SNAP" >&2; exit 1; }

# Refuse to replace the subvolume we are currently running from. btrfs will
# happily rename a mounted subvolume and the system keeps working right up
# until something needs a fresh path lookup, so this fails late and badly.
# The live root is mounted as /, not at $TOP/@, so checking $TOP/@ with
# mountpoint would look correct and catch nothing.
if awk -v sv="/$SAKURA_ROOT_SUBVOL" '
        $2 == "/" && $3 == "btrfs" {
            n = split($4, opts, ",")
            for (i = 1; i <= n; i++)
                if (opts[i] == "subvol=" sv) { found = 1 }
        }
        END { exit !found }
    ' /proc/mounts 2>/dev/null; then
    echo "$SAKURA_ROOT_SUBVOL is mounted as /; rollback must run from the recovery environment" >&2
    exit 1
fi

# The initramfs has no date(1), so a timestamp cannot be relied on for
# uniqueness -- and a fixed fallback name means the second rollback collides
# with the first and fails halfway. Find a free name instead.
STAMP=$(date -u +%Y%m%d-%H%M%S 2>/dev/null || true)
case "$STAMP" in
    ????????-??????) BASE="$TOP/@rollback-$STAMP" ;;
    *)               BASE="$TOP/@rollback-from-$NUM" ;;
esac

PREVIOUS="$BASE"
_n=1
while [ -e "$PREVIOUS" ]; do
    PREVIOUS="$BASE-$_n"
    _n=$((_n + 1))
    if [ "$_n" -gt 100 ]; then
        echo "too many preserved roots at $BASE*; clean some up first" >&2
        exit 1
    fi
done

# Keep the state we are replacing rather than deleting it. If the rollback was
# the wrong call, the only copy of the "broken" system is the one thing that
# can prove what actually went wrong -- and users roll back for the wrong
# reason often enough that this must not be a one-way door.
if [ -d "$ROOT" ]; then
    echo "preserving current root as ${PREVIOUS##*/}"
    mv "$ROOT" "$PREVIOUS"
fi

echo "restoring snapshot $NUM into $SAKURA_ROOT_SUBVOL"
if ! btrfs subvolume snapshot "$SNAP" "$ROOT"; then
    # Put the old root back rather than leaving the machine with no root
    # subvolume at all, which would be unbootable with no way in.
    echo "snapshot creation failed; restoring previous root" >&2
    [ -d "$PREVIOUS" ] && mv "$PREVIOUS" "$ROOT"
    exit 1
fi

# Tell the next boot that the boot image no longer matches this root.
#
# The ESP is not in any snapshot, so the UKI still holds the initramfs built
# by whatever update is being rolled back past. sakura-kernel-sync was meant
# to cover that and only asks whether the running kernel has its modules --
# which is true whenever the rollback did not cross a kernel change, so it
# stays silent while the initramfs and the root disagree about everything
# else they share. Measured on a real machine: rolling back across an update
# that changed sakura-plymouth left a boot that hung at "Terminate Plymouth
# Boot Screen" and never reached a desktop.
#
# A rollback replaces the root wholesale, so the honest statement is that the
# boot image was built against a different system and has to be rebuilt. No
# detection required.
mkdir -p "$ROOT/var/lib/sakura"
printf 'rolled back to snapshot %s\n' "$NUM" > "$ROOT/var/lib/sakura/boot-image-stale"

# A "pre" snapshot is taken by snap-pac while pacman is holding its lock, so
# restoring one restores the lock with it. Nothing is running in a subvolume
# that was created a moment ago, so the file is stale by definition -- but
# pacman does not know that and refuses every transaction until somebody
# deletes a file they have never heard of. Measured after a real rollback:
# enabling Windows support failed with "unable to lock database" on a machine
# where no package manager had run since boot.
rm -f "$ROOT/var/lib/pacman/db.lck"

echo "rollback complete"
