#!/usr/bin/env python3
"""Ask for a rollback to happen on the next boot.

Rolling back cannot be done on a running system: the root subvolume has to be
replaced while it is not mounted, which only the recovery environment can do.
So the desktop records what was chosen and reboots, and the initramfs carries
it out before the system comes up.

Accepts one snapshot number and nothing else. Called through pkexec from the
Update Center, so its whole argument surface is one integer that has to name a
snapshot that exists.
"""
from __future__ import annotations

import os
import re
import sys
from pathlib import Path

SNAPSHOTS = Path(os.environ.get("SAKURA_SNAPSHOT_DIR", "/.snapshots"))
REQUEST = Path(os.environ.get("SAKURA_ROLLBACK_REQUEST_PATH",
                              "/etc/sakura/rollback-request"))


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def main() -> int:
    if os.geteuid() != 0:
        return fail("must run as root")

    args = sys.argv[1:]
    if args == ["--cancel"]:
        REQUEST.unlink(missing_ok=True)
        print("rollback cancelled")
        return 0

    if len(args) != 1 or not re.fullmatch(r"[0-9]{1,9}", args[0]):
        return fail("usage: sakura-schedule-rollback <snapshot-number> | --cancel")

    number = args[0]
    # The recovery environment checks this too, but refusing here means the
    # user finds out now rather than after a reboot into a picker that cannot
    # do what they asked.
    if not (SNAPSHOTS / number / "snapshot").is_dir():
        return fail(f"restore point {number} does not exist")

    REQUEST.parent.mkdir(parents=True, exist_ok=True)
    tmp = REQUEST.with_suffix(".tmp")
    tmp.write_text(number + "\n")
    os.chmod(tmp, 0o644)
    # Atomic: a half-written request read by the initramfs would be a rollback
    # to a snapshot number nobody chose.
    os.replace(tmp, REQUEST)
    print(f"rollback to restore point {number} scheduled for the next boot")
    return 0


if __name__ == "__main__":
    sys.exit(main())
