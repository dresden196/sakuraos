#!/bin/bash
# mkinitcpio install hook: build the SakuraOS recovery environment.

build() {
    add_binary btrfs
    add_binary findfs
    add_binary mountpoint
    add_binary sync
    # The boot counter lives on the ESP, so this image has to be able to mount
    # a FAT filesystem. base provides mount, but not necessarily the module.
    add_binary mount
    add_binary umount
    add_module vfat
    add_module nls_cp437
    add_module nls_iso8859-1

    add_file /usr/lib/sakura/snapshot-boot/lib.sh
    add_file /usr/lib/sakura/snapshot-boot/sakura-rollback
    add_file /usr/lib/sakura/snapshot-boot/sakura-recovery-menu

    add_runscript
}

help() {
    cat <<'HELPEOF'
Provides the SakuraOS recovery picker.

Both images carry it, and it does three things on every boot: honours
sakura.recovery on the command line, carries out a rollback the desktop asked
for, and counts boots so that a machine which repeatedly fails to reach a
working desktop offers recovery by itself.

The count is kept on the ESP rather than in the root filesystem, because the
root filesystem is the thing most likely to be broken when this matters.
HELPEOF
}
