# Maintainer: SakuraOS <dev@sakuraos.invalid>
#
# Replaces limine-snapper-sync, limine-entry-tool and limine-mkinitcpio-hook.
# Those are three GraalVM-compiled Kotlin projects from a single upstream, and
# all three currently fail to build against Arch's gradle. This does the one
# job SakuraOS actually needs from them, in shell, with tests.
pkgname=sakura-snapshot-boot
pkgver=0.1.0
pkgrel=1
pkgdesc="Snapshot rollback and boot menu generation for SakuraOS"
arch=('any')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
depends=('btrfs-progs' 'limine' 'snapper' 'mkinitcpio')
conflicts=('limine-snapper-sync' 'limine-entry-tool')
source=(
    'lib.sh'
    'sakura-rollback'
    'sakura-recovery-menu'
    'sakura-boot-entries'
    'initcpio-install'
    'initcpio-hook'
    'sakura-schedule-rollback'
    'sakura-snapshot-manage'
    'sakura-boot-success'
    'sakura-boot-success.service'
    'org.sakuraos.rollback.policy'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm644 "$srcdir/lib.sh"              "$pkgdir/usr/lib/sakura/snapshot-boot/lib.sh"
    install -Dm755 "$srcdir/sakura-rollback"     "$pkgdir/usr/lib/sakura/snapshot-boot/sakura-rollback"
    install -Dm755 "$srcdir/sakura-recovery-menu" "$pkgdir/usr/lib/sakura/snapshot-boot/sakura-recovery-menu"
    install -Dm755 "$srcdir/sakura-boot-entries" "$pkgdir/usr/bin/sakura-boot-entries"
    # Scheduling a rollback is a privileged action reachable from the desktop;
    # performing one still only happens in the recovery environment.
    install -Dm755 "$srcdir/sakura-boot-success" \
        "$pkgdir/usr/lib/sakura/snapshot-boot/sakura-boot-success"
    install -Dm644 "$srcdir/sakura-boot-success.service" \
        "$pkgdir/usr/lib/systemd/system/sakura-boot-success.service"
    install -Dm755 "$srcdir/sakura-snapshot-manage" \
        "$pkgdir/usr/lib/sakura/snapshot-boot/sakura-snapshot-manage"
    install -Dm755 "$srcdir/sakura-schedule-rollback" \
        "$pkgdir/usr/lib/sakura/snapshot-boot/sakura-schedule-rollback"
    install -Dm644 "$srcdir/org.sakuraos.rollback.policy" \
        "$pkgdir/usr/share/polkit-1/actions/org.sakuraos.rollback.policy"

    install -Dm644 "$srcdir/initcpio-install" "$pkgdir/usr/lib/initcpio/install/sakura-recovery"
    install -Dm644 "$srcdir/initcpio-hook"    "$pkgdir/usr/lib/initcpio/hooks/sakura-recovery"
}
