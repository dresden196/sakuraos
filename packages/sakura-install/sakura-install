#!/usr/bin/env bash
# Lay down a SakuraOS system on a target disk.
#
# This is the installer's backend, not its face. The Qt installer drives this
# rather than reimplementing it, so the partitioning, boot chain and Secure
# Boot setup have exactly one implementation and it is the one under test.
#
#   sakura-install --disk /dev/vda --hostname sakura --user dresden
#
# DESTROYS EVERYTHING on the target disk.
set -euo pipefail

# set -e is worth having and it fails in the worst possible way: the script
# stops, the exit status is 1, and nothing is printed. Three separate bugs in
# this installer presented as "the log just ends" -- once mid-keyring, once at
# a graphics assignment, once at a package query for a package that is not
# installed yet. The trap costs nothing and turns every one of them into a
# line number.
trap 'rc=$?; [[ $rc -ne 0 ]] && printf "\n[sakura-install] internal error: line %s exited %s\n" "$LINENO" "$rc" >&2; exit $rc' ERR

DISK=""
HOSTNAME_="sakura"
USERNAME=""
USERPASS="sakura"
ROOTPASS=""
TIMEZONE="UTC"
LOCALE="en_US.UTF-8"
KEYMAP="us"
FEEDBACK="off"
ENCRYPT="off"
MODE="wipe"
CRYPTPASS=""
CRYPTPASS_STDIN=0
SECUREBOOT="auto"
THEME="dark"
EXTRA_PACKAGES=""
ASSUME_YES=0

die() { printf '\n[sakura-install] %s\n\n' "$*" >&2; exit 1; }
step() { printf '\n[sakura-install] == %s ==\n' "$*"; }
info() { printf '[sakura-install] %s\n' "$*"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --disk)       DISK="$2"; shift 2 ;;
        --hostname)   HOSTNAME_="$2"; shift 2 ;;
        --user)       USERNAME="$2"; shift 2 ;;
        --password)   USERPASS="$2"; shift 2 ;;
        --root-password) ROOTPASS="$2"; shift 2 ;;
        --timezone)   TIMEZONE="$2"; shift 2 ;;
        --locale)     LOCALE="$2"; shift 2 ;;
        --keymap)     KEYMAP="$2"; shift 2 ;;
        --feedback)   FEEDBACK="$2"; shift 2 ;;   # on | off
        --encrypt)    ENCRYPT="$2"; shift 2 ;;    # on | off
        --mode)       MODE="$2"; shift 2 ;;        # wipe | alongside
        # Read from standard input, never taken as an argument: anything on a
        # command line is in /proc for every process on the machine to read,
        # and this is the one secret here that outlives the install.
        --encryption-password-stdin) CRYPTPASS_STDIN=1; shift ;;
        --secureboot) SECUREBOOT="$2"; shift 2 ;;   # auto | on | off
        --extra-packages) EXTRA_PACKAGES="$2"; shift 2 ;;
        --method) METHOD="$2"; shift 2 ;;
        --graphics) GRAPHICS="$2"; shift 2 ;;
        --theme) THEME="$2"; shift 2 ;;         # dark | light   # auto | nvidia-open | nvidia-580xx | nouveau | none
        --yes)        ASSUME_YES=1; shift ;;
        *) die "unknown option: $1" ;;
    esac
done

[[ $EUID -eq 0 ]] || die "must run as root"
[[ -n "$DISK" ]] || die "--disk is required"
[[ -b "$DISK" ]] || die "$DISK is not a block device"
[[ -n "$USERNAME" ]] || die "--user is required"
if [[ "$ENCRYPT" == "on" && "$CRYPTPASS_STDIN" == "1" ]]; then
    IFS= read -r CRYPTPASS || true
fi
if [[ "$ENCRYPT" == "on" ]]; then
    # Checked here rather than at the point of use: discovering an empty
    # passphrase after the disk has been wiped leaves a machine with neither
    # its old system nor a new one.
    [[ -n "$CRYPTPASS" ]] || die "a passphrase must be supplied on stdin with --encrypt on"
    command -v cryptsetup >/dev/null || die "cryptsetup is not available"
fi

# Refuse to install onto the disk the live system is running from. Getting this
# wrong destroys the machine you are installing from, and the check is cheap.
LIVE_SRC=$(findmnt -no SOURCE / 2>/dev/null || true)
if [[ -n "$LIVE_SRC" ]]; then
    LIVE_DISK=$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null | head -1 || true)
    if [[ -n "$LIVE_DISK" && "/dev/$LIVE_DISK" == "$DISK" ]]; then
        die "$DISK is the disk this system is running from"
    fi
fi

if (( ! ASSUME_YES )); then
    lsblk -o NAME,SIZE,TYPE,MOUNTPOINTS "$DISK"
    read -rp "Erase ALL data on $DISK? type ERASE to continue: " confirm
    [[ "$confirm" == "ERASE" ]] || die "aborted"
fi

# Partition naming differs between /dev/sda2 and /dev/nvme0n1p2.
partname() { [[ "$DISK" =~ [0-9]$ ]] && echo "${DISK}p$1" || echo "${DISK}$1"; }

# The EFI system partition already on this disk, if there is one. An installed
# Windows or another Linux keeps its bootloader there, and reformatting it is
# how a dual-boot install destroys the system it was supposed to sit beside.
find_existing_esp() {
    local part
    for part in $(lsblk -lnpo NAME,PARTTYPE "$DISK" 2>/dev/null \
      | awk 'tolower($2) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" {print $1}'); do
        printf '%s' "$part"
        return 0
    done
    return 1
}

# The largest run of unallocated space, in MiB, as "start end size".
largest_free_space() {
    parted -ms "$DISK" unit MiB print free 2>/dev/null \
        | awk -F: '$5 == "free;" {
  gsub(/MiB/, "", $2); gsub(/MiB/, "", $3); gsub(/MiB/, "", $4)
  if ($4 + 0 > best + 0) { best = $4; s = $2; e = $3 }
          }
          END { if (best > 0) print s, e, best }'
}

swapoff -a 2>/dev/null || true
umount -R /mnt 2>/dev/null || true

# Only when the packages come over the network. A copy install is the whole
# reason this can be done with the cable out, so requiring a connection first
# would defeat the point of it.
if [[ "${METHOD:-copy}" == "online" ]]; then
step "Checking this machine can reach the package repositories"
# Before anything is written to the disk, and that ordering is the point.
#
# Only 25 packages ride on the install media; everything else -- base,
# systemd, the whole of Plasma, the fonts, the codecs -- is fetched from
# Arch's mirrors while installing. There is no offline install and no way to
# resume one: pacstrap either completes or it does not.
#
# Partitioning used to happen first. On a machine with no network that meant
# the disk was erased, formatted, possibly encrypted, and only then did the
# download fail -- leaving somebody with no operating system and none of
# what used to be on the drive either. The check costs a second and it
# happens while the disk is still untouched.
_reachable() {
    curl -sS -o /dev/null --max-time 15 "$1" 2>/dev/null
}
if ! _reachable "https://repo.sakuraos.org/sakura-core/os/x86_64/sakura-core.db" \
   && ! _reachable "http://173.233.87.167/sakura-core/os/x86_64/sakura-core.db"; then
    die "this machine cannot reach the SakuraOS repository.

SakuraOS downloads most of itself while installing, so it needs a working
connection before anything is written to the disk. Nothing has been changed.

Go back to the Network step, connect, and try again."
fi
if ! _reachable "https://geo.mirror.pkgbuild.com/core/os/x86_64/core.db" \
   && ! _reachable "https://mirror.rackspace.com/archlinux/core/os/x86_64/core.db"; then
    die "this machine cannot reach the Arch Linux mirrors.

Most of SakuraOS comes from them, so the install would stop part way through
with the disk already erased. Nothing has been changed.

Check the connection on the Network step and try again."
fi
fi

if [[ "$MODE" == "alongside" ]]; then
    step "Making room on $DISK without disturbing what is there"

    ESP=$(find_existing_esp) || die "no EFI system partition found on $DISK. \
SakuraOS can only install alongside a system that already boots in UEFI mode."

    read -r FREE_START FREE_END FREE_SIZE <<<"$(largest_free_space)"
    [[ -n "${FREE_SIZE:-}" ]] || die "no unallocated space on $DISK. \
Shrink an existing partition first -- from Windows' own Disk Management if \
this machine has Windows on it, which can move files SakuraOS cannot."
    # 25 GiB is the point below which the system fits and then immediately
    # runs out during its first update.
    (( ${FREE_SIZE%.*} >= 25600 )) || die "only ${FREE_SIZE%.*} MiB free on $DISK; \
SakuraOS needs at least 25 GiB."

    info "reusing the existing EFI partition at $ESP"
    info "installing into ${FREE_SIZE%.*} MiB of free space"

    # -n 0: the next free partition number, so nothing existing is renumbered.
    #
    # One MiB short of where parted says the free space ends. When that space
    # runs to the end of the disk, the last sectors belong to the backup GPT
    # header, and asking for them makes sgdisk refuse the whole operation --
    # safely, but the install stops. A MiB is far more slack than the header
    # needs and is invisible against 25 GiB.
    FREE_END_MIB=$(( ${FREE_END%.*} - 1 ))
    sgdisk -n "0:${FREE_START%.*}MiB:${FREE_END_MIB}MiB" -t 0:8304 \
        -c 0:"SAKURA_ROOT" "$DISK" >/dev/null
    partprobe "$DISK"; udevadm settle

    # Whichever partition now carries our name. Reading it back rather than
    # assuming a number is what keeps this correct on a disk that already has
    # partitions in an order nobody chose.
    ROOT=$(lsblk -lnpo NAME,PARTLABEL "$DISK" \
           | awk '$2 == "SAKURA_ROOT" {print $1; exit}')
    [[ -n "$ROOT" && -b "$ROOT" ]] || die "could not find the partition just created"
    step "Creating filesystems"
    # The ESP is deliberately not formatted: it belongs to the system already
    # installed here, and our files go alongside theirs.
else
    ESP=$(partname 1)
    ROOT=$(partname 2)

    step "Partitioning $DISK"
    # Anything still holding the disk makes partitioning silently not take
    # effect.
    wipefs -af "$DISK" >/dev/null
    sgdisk --zap-all "$DISK" >/dev/null

    # 1 GiB ESP: a UKI is the kernel plus the whole initramfs, and there are
    # two of them (system and recovery). The usual 512 MiB runs out during a
    # kernel upgrade, which is the worst possible moment to discover it.
    sgdisk -n 1:0:+1G   -t 1:ef00 -c 1:"SAKURA_ESP"  "$DISK" >/dev/null
    sgdisk -n 2:0:0     -t 2:8304 -c 2:"SAKURA_ROOT" "$DISK" >/dev/null
    partprobe "$DISK"; udevadm settle

    step "Creating filesystems"
    mkfs.fat -F32 -n SAKURA_ESP "$ESP" >/dev/null
fi

# Encryption, if asked for.
#
# LUKS2 on the partition, with the filesystem on the mapper above it. Rollback
# is unaffected by this: sakura-rollback renames subvolumes on a mounted
# btrfs and never touches the block device, so whether that device is an
# encrypted mapping is not something it can tell. The one part that cares is
# the recovery environment finding the disk at all, which is why the encrypt
# hook has to be in both images -- see the mkinitcpio section below.
#
# The ESP stays unencrypted because firmware has to read it. That is true of
# every encrypted Linux system and is why the kernel and initramfs are signed:
# tampering with them is the attack that unencrypted boot partition allows.
CRYPT_UUID=""
FSROOT="$ROOT"
if [[ "$ENCRYPT" == "on" ]]; then
    step "Encrypting $ROOT"
    # --key-file - so the passphrase never appears in a command line, where
    # every other process on the machine could read it from /proc.
    printf '%s' "$CRYPTPASS" | cryptsetup luksFormat --type luks2 \
        --batch-mode --key-file - "$ROOT"
    printf '%s' "$CRYPTPASS" | cryptsetup open --key-file - "$ROOT" cryptroot
    CRYPT_UUID=$(blkid -s UUID -o value "$ROOT")
    FSROOT="/dev/mapper/cryptroot"
    info "encrypted; LUKS UUID: $CRYPT_UUID"
fi

mkfs.btrfs -f -L SAKURA "$FSROOT" >/dev/null

ROOT_UUID=$(blkid -s UUID -o value "$FSROOT")
info "root UUID: $ROOT_UUID"

step "Creating subvolumes"
mount "$FSROOT" /mnt
# @log and @pkg are separate subvolumes so a rollback of @ does not also roll
# back the logs that explain what went wrong, or throw away the package cache
# that a recovery might need.
for sv in @ @home @log @pkg @snapshots; do
    btrfs subvolume create "/mnt/$sv" >/dev/null
done
umount /mnt

BTRFS_OPTS="noatime,compress=zstd:3,space_cache=v2"
mount -o "$BTRFS_OPTS,subvol=@" "$FSROOT" /mnt
mkdir -p /mnt/{home,var/log,var/cache/pacman/pkg,.snapshots,boot}
mount -o "$BTRFS_OPTS,subvol=@home"      "$FSROOT" /mnt/home
mount -o "$BTRFS_OPTS,subvol=@log"       "$FSROOT" /mnt/var/log
mount -o "$BTRFS_OPTS,subvol=@pkg"       "$FSROOT" /mnt/var/cache/pacman/pkg
mount -o "$BTRFS_OPTS,subvol=@snapshots" "$FSROOT" /mnt/.snapshots
mount "$ESP" /mnt/boot

# Pick the graphics driver from the card that is actually present.
#
# NVIDIA driver 590 dropped Pascal and Maxwell, and Arch no longer ships a
# proprietary kernel module at all -- only nvidia-open, which needs Turing or
# newer. So there are three answers, not one.
#
# The generation is inferred from the PCI device ID. This is a heuristic:
# NVIDIA allocates IDs roughly in architecture order, so a threshold works,
# but it is not a guarantee and a brand-new card could land outside it. The
# decision is therefore logged, and --graphics overrides it.
detect_graphics() {
    local ids id
    ids=$(lspci -n -d '10de::0300' 2>/dev/null | awk '{print $3}' | cut -d: -f2)
    [[ -n "$ids" ]] || { echo "none"; return; }

    local best=0
    for id in $ids; do
        local n=$((16#$id))
        # Not "(( ... )) && best=$n": that returns 1 when the test is false,
        # and under set -e it ends the installer. It only bites a machine with
        # more than one NVIDIA card whose second card has the lower device id,
        # which is rare enough to have survived unnoticed and awkward enough
        # to debug if it ever fired.
        if (( n > best )); then
            best=$n
        fi
    done

    # 0x1E00 is the first Turing part; anything at or above it is supported by
    # the current driver. 0x1340 is the first Maxwell part; between the two is
    # Maxwell and Pascal, which only the frozen 580xx branch still drives.
    if (( best >= 0x1E00 )); then
        echo "nvidia-open"
    elif (( best >= 0x1340 )); then
        echo "nvidia-580xx"
    else
        echo "nouveau"
    fi
}

# Which x86-64 feature level this machine has, and therefore which kernel it
# can run at all. The tuned kernel is built for x86-64-v3 -- AVX2 and its
# neighbours, roughly Haswell (2013) and Excavator (2015) onward. Older
# hardware gets the stock kernel and gets it quietly: a machine that cannot
# run the fast kernel is not a machine with a problem.
#
# glibc's loader is asked rather than /proc/cpuinfo parsed. It is the same
# check the dynamic linker uses to pick hwcaps libraries, so this agrees with
# the rest of the system by construction instead of by our reading of a flag
# list. Flags are the fallback for a loader that is not where it should be.
cpu_supports_v3() {
    local ld
    for ld in /lib/ld-linux-x86-64.so.2 /usr/lib/ld-linux-x86-64.so.2; do
        [[ -x "$ld" ]] || continue
        if "$ld" --help 2>/dev/null | grep -q "x86-64-v3 (supported"; then
return 0
        fi
        # It answered and did not list v3, which is an answer.
        if "$ld" --help 2>/dev/null | grep -q "x86-64-v2"; then
return 1
        fi
    done
    local f
    for f in avx avx2 bmi1 bmi2 f16c fma movbe; do
        grep -qw "$f" /proc/cpuinfo || return 1
    done
    return 0
}

# The kernel is decided here rather than named in sakura-desktop, because it
# depends on the machine in front of us. The meta package deliberately names
# no kernel at all, the way Arch's own base does not.
# Whether this machine has a route out, asked once and remembered. An offline
# install is a supported case now, and the steps below differ enough that
# discovering it separately in each of them means each one discovers it the
# slow way: pacman works through every mirror in the list, timing out on each.
HAVE_NET=no
if _reachable "https://geo.mirror.pkgbuild.com/core/os/x86_64/core.db" \
   || _reachable "https://repo.sakuraos.org/sakura-core/os/x86_64/sakura-core.db"; then
    HAVE_NET=yes
fi
[[ "$HAVE_NET" == "yes" ]] || info "no network: installing from the disc alone"

KERNEL="linux"
# pacman -Si reads the sync databases, and on a freshly booted live image
# those have not been loaded yet -- so the query returns nothing, the tuned
# kernel looks absent, and every machine quietly gets the stock one. That is
# exactly what happened on the first real install: the CPU reported v3 and
# stock was installed anyway. Cheap on file:// media, and it has to happen
# before pacstrap regardless.
# Bounded when there is no network. The mirrorlist is mostly network mirrors,
# and pacman tries each in turn: offline this took over twelve minutes and
# blew the installer's own deadline, having achieved nothing. The file://
# repository on the media syncs in well under a second, so the short bound
# still gets what this check actually needs.
if [[ "$HAVE_NET" == "yes" ]]; then
    pacman -Sy >/dev/null 2>&1 || true
else
    timeout 30 pacman -Sy >/dev/null 2>&1 || true
    # timeout kills pacman mid-transaction and pacman leaves its lock behind,
    # so the next pacman call fails with "could not lock database". Nothing
    # else is using it here: we started it and we killed it.
    rm -f /var/lib/pacman/db.lck
fi
if cpu_supports_v3; then
    if pacman -Si linux-cachyos >/dev/null 2>&1; then
        KERNEL="linux-cachyos"
        info "CPU supports x86-64-v3: installing the tuned kernel"
    else
        # Worth saying plainly. This machine could run the tuned kernel and is
        # not getting it, which is a packaging problem rather than a property
        # of the hardware, and it should not read like a normal outcome.
        info "WARNING: this CPU supports x86-64-v3 but linux-cachyos was not"
        info "found in the repository; falling back to the stock kernel"
    fi
else
    info "CPU is older than x86-64-v3: using the stock kernel"
fi

GRAPHICS="${GRAPHICS:-auto}"
if [[ "$GRAPHICS" == "auto" ]]; then
    GRAPHICS=$(detect_graphics)
fi

GRAPHICS_PACKAGES=""
case "$GRAPHICS" in
    nvidia-open)
        GRAPHICS_PACKAGES="nvidia-open nvidia-utils"
        info "NVIDIA card, Turing or newer: installing nvidia-open"
        ;;
    nvidia-580xx)
        # DKMS builds against the running kernel, so the target needs headers
        # and a compiler for this to survive the next kernel update.
        GRAPHICS_PACKAGES="nvidia-580xx-dkms nvidia-580xx-utils ${KERNEL}-headers base-devel"
        info "NVIDIA card older than Turing: installing the frozen 580xx branch"
        info "NVIDIA no longer supports this GPU; SakuraOS maintains this driver"
        ;;
    nouveau)
        info "NVIDIA card too old for any current driver: using nouveau"
        ;;
    none)
        info "no NVIDIA card detected: using the open drivers"
        ;;
    *)
        die "unknown --graphics value: $GRAPHICS"
        ;;
esac

# How the system gets onto the disk.
#
#   copy    transfer the filesystem this installer is running from
#   online  rebuild it from packages with pacstrap
#
# Copy is the default and is what Ubuntu, Fedora and Mint do. The install
# media already carries a complete, working SakuraOS -- it is what booted
# this installer -- so rebuilding the same system by fetching 1.7 GB of
# packages is downloading a copy of something already on the disc. Copying
# it works with no network at all and takes a fraction of the time.
#
# Online stays because an old ISO installs an old system: with a network
# and a small disk, pacstrap gets current packages without a 3 GB download
# of things that are then immediately replaced.
METHOD="${METHOD:-copy}"

if [[ "$METHOD" == "copy" ]]; then
    step "Copying the system onto $DISK"
    SQUASH_ROOT=/run/archiso/airootfs
    [[ -d "$SQUASH_ROOT" ]] || die "this is not the install media -- \
there is no filesystem at $SQUASH_ROOT to copy. Use --method online."

    # Everything except the parts that exist only because this is running
    # from a disc. /boot is the ESP and is written later; the kernel and the
    # UKI are generated after the copy, not carried over from the live image.
    # Progress is deliberately not asked for. --info=progress2 writes a line
    # per file to whatever is capturing this, and on 207,000 files that was a
    # 16 MB log with the actual error buried in it.
    #
    # 23 and 24 are not failures here. Copying a filesystem that is currently
    # running means files can vanish underneath the copy and a few are
    # unreadable by anyone; rsync says so and carries on, and under set -e
    # that would end the install after the work was already done.
    rsync -aAXH \
        --exclude=/proc/* --exclude=/sys/* --exclude=/dev/* --exclude=/run/* \
        --exclude=/tmp/* --exclude=/mnt/* --exclude=/media/* \
        --exclude=/boot/* \
        --exclude=/var/cache/pacman/pkg/* \
        --exclude=/var/log/* \
        --exclude=/etc/machine-id \
        --exclude=/etc/ssh/ssh_host_* \
        --exclude=/home/* \
        --exclude=/root/* \
        "$SQUASH_ROOT"/ /mnt/ 2>&1 | tail -2 || {
        _rc=${PIPESTATUS[0]}
        case "$_rc" in
0|23|24) : ;;
*) die "copying the system failed (rsync exit $_rc)." ;;
        esac
    }

    # rsync copies the empty directories but not their modes reliably, and
    # arch-chroot needs these to exist before it can bind-mount onto them.
    # An excluded directory that never gets created is a failed install.
    for d in proc sys dev run tmp mnt media home root boot var/log \
 var/cache/pacman/pkg; do
        mkdir -p "/mnt/$d"
    done
    chmod 555 /mnt/proc /mnt/sys
    # /mnt/boot is a mounted vfat ESP: chmod is not supported there.
    chmod 755 /mnt/dev /mnt/run /mnt/mnt /mnt/media /mnt/home
    chmod 1777 /mnt/tmp
    chmod 700 /mnt/root

    step "Making it a permanent system rather than a live one"
    # A live filesystem carries state that a fresh install must not inherit,
    # and this is the step the whole method stands or falls on. Three bugs
    # in this project hid behind exactly this kind of leakage -- a machine
    # that had been developed on had git and a populated wallet that a real
    # user's would not, and the tests passed because of it.

    # Identity is generated on first boot, not shared by every machine ever
    # installed from this ISO.
    rm -f /mnt/etc/machine-id /mnt/var/lib/dbus/machine-id
    : > /mnt/etc/machine-id
    rm -f /mnt/etc/ssh/ssh_host_*

    # The live user does not exist on an installed system. Their group,
    # home and autologin go with them.
    arch-chroot /mnt userdel -r sakura 2>/dev/null || true
    rm -rf /mnt/home/sakura
    rm -f /mnt/etc/sudoers.d/g_wheel /mnt/etc/sudoers.d/sakura-live
    rm -rf /mnt/etc/systemd/system/getty@tty1.service.d \
           /mnt/etc/systemd/system/serial-getty@ttyS0.service.d

    # The installer itself, and the thing that starts it.
    rm -f /mnt/etc/xdg/autostart/sakura-installer.desktop

    # archiso's own machinery: boot hooks that look for a squashfs, the
    # services that only make sense on live media, and its mkinitcpio
    # preset. Left behind, the installed system builds an initramfs that
    # tries to find a disc that is not there.
    # Order matters: removing mkinitcpio-archiso fires a hook that rebuilds
    # the initramfs, and it reads whatever preset is on disk. With the live
    # preset still there the hook fails on "'/boot/vmlinuz-linux' must be
    # readable" -- /boot is the ESP here, not the live media. Clear the
    # config first, then remove the package.
    rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf
    if [[ -f /mnt/etc/mkinitcpio.d/linux.preset ]] \
       && grep -q archiso /mnt/etc/mkinitcpio.d/linux.preset 2>/dev/null; then
        rm -f /mnt/etc/mkinitcpio.d/linux.preset
    fi
    arch-chroot /mnt pacman -Rns --noconfirm \
        mkinitcpio-archiso archinstall 2>/dev/null || true
    rm -f /mnt/etc/systemd/system/multi-user.target.wants/choose-mirror.service \
          /mnt/etc/systemd/system/multi-user.target.wants/livecd-talk.service \
          /mnt/etc/systemd/system/multi-user.target.wants/pacman-init.service
    rm -f /mnt/etc/systemd/system/choose-mirror.service \
          /mnt/etc/systemd/system/livecd-talk.service \
          /mnt/etc/systemd/system/pacman-init.service
    rm -f /mnt/root/.automated_script.sh /mnt/root/.zlogin

    # archiso mounts a tmpfs over /etc/pacman.d/gnupg so the live session can
    # build a keyring in RAM. Left behind, that mount unit runs on the
    # installed system too and hides the real keyring underneath an empty
    # tmpfs at every boot: the keyring is present on disk and in the
    # snapshots, and pacman still reports "keyring is not writable" and
    # refuses every signature. Removing pacman-init.service was not enough,
    # because it is the mount rather than the init that does the damage.
    rm -f /mnt/etc/systemd/system/etc-pacman.d-gnupg.mount
    rm -f /mnt/etc/systemd/system/*.target.wants/etc-pacman.d-gnupg.mount

    # The live user's own service goes with the live user.
    rm -f /mnt/etc/systemd/system/sakura-live-user.service
    rm -f /mnt/etc/systemd/system/*.target.wants/sakura-live-user.service

    # Anything else archiso left in /etc/systemd/system that belongs to the
    # live image. Named units above are the ones known to cause damage; this
    # catches the rest rather than waiting for each to be discovered by a
    # failed install.
    for _u in /mnt/etc/systemd/system/*.mount; do
        [ -e "$_u" ] || continue
        if grep -q "archiso\|Temporary" "$_u" 2>/dev/null; then
            info "removing live-media mount unit $(basename "$_u")"
            rm -f "$_u"
        fi
    done

    # Logs, caches and journals from the live session. A new machine should
    # not boot with a record of somebody else's installer run.
    # Contents, not the directories. /var/cache/pacman/pkg is the @pkg
    # subvolume's mountpoint -- kept out of snapshots on purpose -- and
    # removing a mountpoint fails with "Device or resource busy", which is
    # exactly how this step ended the install the first time it ran.
    find /mnt/var/log/journal -mindepth 1 -delete 2>/dev/null || true
    find /mnt/var/tmp -mindepth 1 -delete 2>/dev/null || true
    find /mnt/var/cache -mindepth 1 -maxdepth 1 -not -name pacman \
        -exec rm -rf {} + 2>/dev/null || true
    find /mnt/var/cache/pacman/pkg -mindepth 1 -delete 2>/dev/null || true

    step "Adding what this machine needs"
    # The kernel is not carried over: the live image boots stock linux and
    # this machine may want the tuned one. Graphics and any extras are
    # installed the same way they always were.
    # The squashfs carries an empty keyring. archiso initialises it at boot
    # into the live overlay, and we copy from the pristine image rather than
    # from the overlay on purpose, so the new system arrives with nothing in
    # /etc/pacman.d/gnupg and every signature check fails with "keyring is
    # not writable". pacstrap does this for the online path; the copy path
    # has to do it for itself.
    arch-chroot /mnt pacman-key --init >/dev/null 2>&1 \
        || die "could not create the package keyring on the new system."
    # Populate whichever keyrings are actually installed rather than a fixed
    # list: sakura-keyring ships ours, archlinux-keyring ships Arch's, and a
    # name that is not present makes pacman-key fail the whole run.
    _keyrings=""
    for _k in /mnt/usr/share/pacman/keyrings/*.gpg; do
        [ -e "$_k" ] || continue
        _keyrings="$_keyrings $(basename "$_k" .gpg)"
    done
    # shellcheck disable=SC2086
    if [[ -n "$_keyrings" ]]; then
        arch-chroot /mnt pacman-key --populate $_keyrings >/dev/null 2>&1 \
            || die "could not populate the package keyring on the new system."
        info "keyring initialised:$_keyrings"
    fi

    # A copied filesystem has no package databases -- archiso ships none --
    # so every target reads as "not found" until they are fetched. Offline
    # this still succeeds for the on-media repo, which is a file:// path
    # rsync copied onto the new system; the network repos just fail, and
    # that is not fatal because the tuned kernel ships on the media.
    if [[ "$HAVE_NET" == "yes" ]]; then
        arch-chroot /mnt pacman -Sy --noconfirm >/dev/null 2>&1 || true
    else
        timeout 30 arch-chroot /mnt pacman -Sy --noconfirm >/dev/null 2>&1 || true
        # Same again inside the target: a killed sync leaves a lock that the
        # kernel install then cannot take, which is exactly how the first
        # offline install failed after the mirror-list fix.
        rm -f /mnt/var/lib/pacman/db.lck
    fi

    # The kernel is the one thing a copy install genuinely cannot do without:
    # the live image boots stock linux and this machine may want the tuned
    # one, which is on the media and so installs with the network unplugged.
    #
    # Stock linux is a different case. It is already here, because the copy
    # brought it, and it lives in [core] rather than on the media -- so on a
    # machine with no network, asking for it produced "target not found:
    # linux" and failed an install that already had a working kernel sitting
    # on the disk. Ask what is installed rather than assuming the answer.
    # Ask whether the kernel IMAGE is there, not whether the package database
    # says the package is. Those disagree here by design: the copy brings the
    # database, and /boot is excluded from it because /boot is the ESP
    # mountpoint. So pacman -Q linux succeeds on a system that has no
    # vmlinuz-linux at all, and mkinitcpio then fails with "'/boot/vmlinuz-
    # linux' must be readable" after the installer has reported success --
    # which is how a customer VM produced an unbootable disk and said nothing.
    # No "[[ ... ]] && x=y" here: as a standalone statement that returns 1
    # when the test is false, and under set -e it takes the whole installer
    # with it. It did exactly that -- the log ended at "keyring initialised"
    # with exit 1 and not a word about why. The line was redundant anyway,
    # since for the stock kernel the expansion already gives the same path.
    _kernel_image="/mnt/boot/vmlinuz-${KERNEL}"

    # Arch installs the kernel image to /usr/lib/modules/<version>/vmlinuz and
    # a hook copies it to /boot. The copy brings the modules directory and
    # excludes /boot, so the image is on the new system, just not where the
    # preset looks for it. Putting it back costs nothing and works with no
    # network, which is the case that otherwise has no kernel at all: stock
    # linux lives in [core] and is not on the media.
    if [[ ! -r "$_kernel_image" ]]; then
        # pacman -Ql fails when the package is not installed, which is the
        # normal case here, and an assignment from a failing substitution
        # aborts under set -e. That is the third silent exit this file has
        # produced today, so it is guarded rather than assumed.
        _owned=$({ arch-chroot /mnt pacman -Ql "$KERNEL" 2>/dev/null || true; } \
                 | awk '$2 ~ /\/vmlinuz$/ {print $2; exit}')
        if [[ -n "$_owned" && -r "/mnt$_owned" ]]; then
            info "restoring the kernel image the copy left in /usr/lib/modules"
            install -Dm644 "/mnt$_owned" "$_kernel_image"
        fi
    fi

    if [[ -r "$_kernel_image" ]]; then
        info "$KERNEL is already in place"
    elif arch-chroot /mnt pacman -S --noconfirm "$KERNEL" 2>&1 | tail -3; then
        info "installed $KERNEL"
    else
        die "could not install the kernel onto the new system.

The package database says $KERNEL is present but its image is not in /boot,
and it could not be fetched. On a machine with no network this happens when
the tuned kernel is unavailable and the stock one is not on the media."
    fi

    # Whatever route was taken, there must be an image now. Reporting success
    # and leaving an unbootable disk is the worst outcome available here.
    [[ -r "$_kernel_image" ]] \
        || die "no kernel image at ${_kernel_image#/mnt} after installing $KERNEL.
The disk would not boot, so the install has been stopped instead."

    # The live image boots stock linux, so a copy install arrives with it
    # already present and then installs the tuned one beside it. Two kernels
    # is not merely untidy: every kernel update builds both, the boot image
    # is generated for one of them, and "exactly one kernel is installed" is
    # a check this project has precisely because that ambiguity is where
    # boot problems come from.
    #
    # Only when the tuned kernel is the one that was wanted. A machine whose
    # CPU cannot run it keeps stock linux, and removing that would leave it
    # with nothing to boot.
    if [[ "$KERNEL" != "linux" ]] && arch-chroot /mnt pacman -Q "$KERNEL" >/dev/null 2>&1; then
        if arch-chroot /mnt pacman -Q linux >/dev/null 2>&1; then
            info "removing the stock kernel the live image was carrying"
            arch-chroot /mnt pacman -Rns --noconfirm linux linux-headers 2>/dev/null \
                || arch-chroot /mnt pacman -Rdd --noconfirm linux >/dev/null 2>&1 \
                || info "WARNING: could not remove the stock kernel; two kernels are installed"
        fi
    fi

    # Graphics and extras are best-effort by comparison. Offline they may not
    # resolve, and an install that otherwise succeeded should not be thrown
    # away over them -- the live image already carries the open drivers, and
    # the first update after the machine is online will fill in the rest.
    # shellcheck disable=SC2086
    if [[ "$HAVE_NET" != "yes" ]]; then
        info "no network: skipping graphics and extra packages"
        info "the open drivers are already on this system; the first update will fill in the rest"
    elif [[ -n "${GRAPHICS_PACKAGES}${EXTRA_PACKAGES}" ]]; then
        arch-chroot /mnt pacman -S --noconfirm --needed \
            $GRAPHICS_PACKAGES $EXTRA_PACKAGES 2>&1 | tail -3 \
            || info "WARNING: some extra packages could not be installed; \
the system will pick them up once it is online."
    fi

    # Only now is the on-media repo finished with. It is the file:// source
    # the kernel installs from when there is no network, so removing it
    # during the strip -- as this did -- made an offline install impossible
    # while an online one carried on working.
    rm -rf /mnt/usr/share/sakura/repo

    # Only now does the repository swap from the media to the network. Doing
    # it during the strip pointed pacman at HTTPS before the kernel was
    # installed, so an offline install had nowhere to fetch from -- the same
    # ordering mistake as deleting the media repo too early.
    if [[ -f /mnt/etc/pacman.d/sakura-core.conf ]]; then
        sed -i '/^\[sakura-core\]/,/^$/d; /^\[sakura-extra\]/,/^$/d' \
            /mnt/etc/pacman.conf 2>/dev/null || true
        grep -q 'sakura-core.conf' /mnt/etc/pacman.conf \
            || echo 'Include = /etc/pacman.d/sakura-core.conf' >> /mnt/etc/pacman.conf
    fi
else
    step "Installing packages"
    # shellcheck disable=SC2086  # deliberate word splitting of the extras list
    pacstrap -K /mnt "$KERNEL" sakura-desktop $GRAPHICS_PACKAGES $EXTRA_PACKAGES
fi

step "Generating fstab"
genfstab -U /mnt >> /mnt/etc/fstab
# genfstab leaves the ESP world-readable. It holds the boot chain and, once
# Secure Boot is set up, key material -- neither of which any other account
# has business reading.
sed -i 's/fmask=0022,dmask=0022/fmask=0077,dmask=0077/' /mnt/etc/fstab

step "Configuring the system"
echo "$HOSTNAME_" > /mnt/etc/hostname
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /mnt/etc/localtime
# en_US.UTF-8 stays alongside the chosen one: a great deal of software
# assumes it exists, and generating a second locale costs almost nothing.
{
    echo "$LOCALE UTF-8"
    [ "$LOCALE" = "en_US.UTF-8" ] || echo "en_US.UTF-8 UTF-8"
} > /mnt/etc/locale.gen
echo "LANG=$LOCALE" > /mnt/etc/locale.conf

# Keyboard layout, for both the graphical session and the console.
#
# The installer's keyboard screen tells the user that getting this wrong locks
# them out at their first login prompt, and it was right to: the answer used
# to be collected and thrown away, so every machine booted "us" no matter what
# was chosen. Someone who picked their own layout, typed a password on it, and
# then met a us-layout login prompt really was locked out.
#
# Two files, because they are read by different things. Wayland and X sessions
# take the layout from the X11 config; the virtual consoles take a keymap
# name, and the two namespaces do not always agree -- xkb calls the British
# layout "gb" while the console calls it "uk". systemd ships the conversion
# table, so it is used rather than guessed at.
install -d /mnt/etc/X11/xorg.conf.d
cat > /mnt/etc/X11/xorg.conf.d/00-keyboard.conf <<KBD
# Written by sakura-install. Generated from the layout chosen during install.
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "$KEYMAP"
EndSection
KBD

CONSOLE_KEYMAP=$(awk -v want="$KEYMAP" \
    '!/^#/ && $2 == want { print $1; exit }' \
    /mnt/usr/share/systemd/kbd-model-map 2>/dev/null || true)
if [[ -z "$CONSOLE_KEYMAP" ]]; then
    # No console equivalent. The graphical layout is still correct, which is
    # what a desktop user meets; say so rather than silently differing.
    CONSOLE_KEYMAP="$KEYMAP"
    info "no console keymap matches '$KEYMAP'; using it verbatim for the console"
fi
echo "KEYMAP=$CONSOLE_KEYMAP" > /mnt/etc/vconsole.conf
info "keyboard: $KEYMAP (console: $CONSOLE_KEYMAP)"

# The kernel command line never varies -- rollback replaces what @ *is* rather
# than pointing the kernel at a different subvolume. That is what lets this
# stay embedded in a signed UKI. See packages/sakura-snapshot-boot/README.md.
mkdir -p /mnt/etc/kernel
# On an encrypted install the kernel is pointed at the mapping, and the hook
# is told which partition to unlock to produce it. Both images need this:
# recovery has to unlock the disk before it can find anything to roll back,
# and a recovery environment that cannot open the disk is no recovery at all.
if [[ "$ENCRYPT" == "on" ]]; then
    CRYPT_ARG="cryptdevice=UUID=$CRYPT_UUID:cryptroot"
    ROOT_ARG="root=/dev/mapper/cryptroot"
    RECOVERY_ROOT="sakura.root=/dev/mapper/cryptroot"
else
    CRYPT_ARG=""
    ROOT_ARG="root=UUID=$ROOT_UUID"
    RECOVERY_ROOT="sakura.root=UUID=$ROOT_UUID"
fi

echo "$CRYPT_ARG $ROOT_ARG rootflags=subvol=@ rw quiet splash" \
    | tr -s ' ' > /mnt/etc/kernel/cmdline
# Recovery never mounts a root filesystem: it mounts the btrfs top level,
# swaps @, and reboots. So it gets no root= at all -- but it still needs the
# cryptdevice, or there is no top level to mount.
echo "sakura.recovery $CRYPT_ARG $RECOVERY_ROOT rw" \
    | tr -s ' ' > /mnt/etc/kernel/recovery-cmdline

cat > "/mnt/etc/mkinitcpio.d/${KERNEL}.preset" <<PRESET
# Two images from one kernel: the system, and the recovery environment that
# can put the system back. Both are UKIs so both can be Secure Boot signed.
ALL_kver="/boot/vmlinuz-${KERNEL}"

PRESETS=('default' 'recovery')

default_uki="/boot/EFI/sakura/sakura.efi"
default_cmdline="/etc/kernel/cmdline"
# The normal image carries the recovery hook too. It does nothing on an
# ordinary boot -- the flag on the kernel command line is what starts the
# picker -- but its late hook is what notices a rollback asked for from the
# desktop and hands over before the system comes up. Without this the request
# is written and then never acted on, and the Update Center's "go back to
# this" does nothing at all.
default_options="-A sakura-recovery"

recovery_uki="/boot/EFI/sakura/sakura-recovery.efi"
recovery_cmdline="/etc/kernel/recovery-cmdline"
recovery_options="-A sakura-recovery"
PRESET

# btrfs needs to be in the initramfs to find root at all.
# encrypt goes between block and btrfs: it needs the block devices to exist
# and has to produce the mapping before anything tries to read a filesystem
# from it. keyboard and keymap are already ahead of it, which matters more
# than it looks -- the passphrase prompt is the first thing typed on this
# machine, and on the layout the user chose rather than us.
#
# plymouth sits after kms and before encrypt, and both placements are
# load-bearing. After kms, because it cannot draw before the display is up.
# Before encrypt, because on an encrypted disk plymouth is what asks for the
# passphrase -- put it after and the user gets a bare text prompt on top of a
# splash that has already started, which looks like a failure.
if [[ "$ENCRYPT" == "on" ]]; then
    HOOKS_LINE="HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont plymouth block encrypt btrfs filesystems fsck)"
else
    HOOKS_LINE="HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont plymouth block btrfs filesystems fsck)"
fi
sed -i "s/^HOOKS=.*/$HOOKS_LINE/" \
    /mnt/etc/mkinitcpio.conf
sed -i 's/^MODULES=.*/MODULES=(btrfs)/' /mnt/etc/mkinitcpio.conf

# plymouth-set-default-theme writes the theme and would rebuild the initramfs
# on its own; -R is deliberately not passed because mkinitcpio runs once at the
# end of this script and rebuilding twice doubles the slowest step of an
# install for no benefit.
arch-chroot /mnt plymouth-set-default-theme sakura >/dev/null 2>&1 \
    || warn "the boot splash theme could not be set; boot will show messages instead"

# Make the target reference our repository exactly once, before [core].
#
# Two different starting states have to end up the same. A normal install gets
# stock Arch's pacman.conf from the pacman package: no [sakura-core] at all, so
# the machine cannot see our packages even though sakura-core.conf is sitting
# right there in /etc/pacman.d. An install driven from a live environment can
# instead inherit that environment's pacman.conf, which defines [sakura-core]
# against file:///usr/share/sakura/repo -- a path that exists only on the ISO
# -- and then registers it a second time through the Include, which is what
# made every pacman run warn about a duplicate database.
#
# So: drop any [sakura-core] block, and ensure exactly one Include, placed
# before [core] because sakura-core.conf says it must be.
python3 - <<'PYCONF'
import pathlib, sys

INCLUDE = "Include = /etc/pacman.d/sakura-core.conf"
# A marker, so a second run strips what the first one wrote instead of
# stacking another copy of the comment above the same Include.
MARKER = "# SakuraOS packages (managed by sakura-install)"
p = pathlib.Path("/mnt/etc/pacman.conf")

out, in_block = [], False
for line in p.read_text().splitlines():
    stripped = line.strip()
    if stripped.startswith("["):
        in_block = stripped == "[sakura-core]"
    if in_block or stripped == INCLUDE or stripped == MARKER:
        continue          # rebuilt below, exactly once
    out.append(line)

try:
    at = next(i for i, l in enumerate(out) if l.strip() == "[core]")
except StopIteration:
    print("no [core] section in the target pacman.conf", file=sys.stderr)
    sys.exit(1)

out[at:at] = [MARKER, INCLUDE, ""]

# Collapse runs of blank lines, so running this twice leaves the file
# byte-identical rather than growing a blank line each time.
collapsed = []
for line in out:
    if not line.strip() and collapsed and not collapsed[-1].strip():
        continue
    collapsed.append(line)
out = collapsed
text = "\n".join(out) + "\n"

# Verify rather than assume: this file decides whether the machine can reach
# its own updates. The checks work on line positions, not string offsets --
# comparing offsets matched the section name inside a comment.
lines = text.splitlines()
headers = [i for i, l in enumerate(lines) if l.strip() == "[sakura-core]"]
includes = [i for i, l in enumerate(lines) if l.strip() == INCLUDE]
cores = [i for i, l in enumerate(lines) if l.strip() == "[core]"]
if headers or len(includes) != 1 or not cores:
    print("pacman.conf rewrite produced an unexpected result", file=sys.stderr)
    sys.exit(1)
if includes[0] > cores[0]:
    print("sakura-core must be included before [core]", file=sys.stderr)
    sys.exit(1)
p.write_text(text)
PYCONF

# Worked out here, not inside the chroot. The heredoc below is expanded by
# this shell, so a variable the chroot would have to compute for itself has to
# exist here first -- and under set -u, one that does not stops the install at
# the very last step, after everything has been downloaded and written.
LANG_CODE="${LOCALE%%.*}"

arch-chroot /mnt /bin/bash -euo pipefail <<CHROOT
locale-gen >/dev/null

# Trust our signing key inside the target. sakura-keyring's own scriptlet runs
# during pacstrap, before the target keyring is usable, so the key ends up
# shipped but never imported -- and the first pacman -Syu on the new system
# fails with "key is unknown" on our own repository.
pacman-key --init >/dev/null 2>&1
pacman-key --populate archlinux sakura >/dev/null 2>&1
pacman-key --updatedb >/dev/null 2>&1

useradd -m -G wheel -s /bin/bash "$USERNAME"
echo "$USERNAME:$USERPASS" | chpasswd
if [ -n "$ROOTPASS" ]; then
    echo "root:$ROOTPASS" | chpasswd
else
    passwd -l root >/dev/null
fi
# KDE's user feedback level, as chosen on the installer's privacy screen.
#
# That screen used to say "Sending basic information to KDE" in the present
# tense and then configure nothing, so it described a state of the system that
# was not true either way. FeedbackLevel is what Plasma reads: 0 is off, 16 is
# the basic system information the screen describes. This goes to KDE and
# never to SakuraOS, which is why it is the only telemetry question asked.
install -d -o "$USERNAME" -g "$USERNAME" "/home/$USERNAME/.config"

# The desktop's language, which is not the same thing as the C library's
# locale. LANG in /etc/locale.conf decides how dates, numbers and currency are
# written; Plasma reads plasma-localerc to decide which translation to load,
# and without it a system installed in German formats dates German and then
# shows every menu in English.
#
# This is the file KDE's own Region & Language page writes, so changing it
# there later works normally and does not fight anything we did here.

cat > "/home/$USERNAME/.config/plasma-localerc" <<LOCALERC
[Formats]
LANG=$LOCALE

[Translations]
LANGUAGE=$LANG_CODE
LOCALERC
chown "$USERNAME:$USERNAME" "/home/$USERNAME/.config/plasma-localerc"
if [ "$FEEDBACK" = "on" ]; then
    printf '[Global]\nFeedbackLevel=16\n' > "/home/$USERNAME/.config/PlasmaUserFeedback"
else
    printf '[Global]\nFeedbackLevel=0\n' > "/home/$USERNAME/.config/PlasmaUserFeedback"
fi
chown "$USERNAME:$USERNAME" "/home/$USERNAME/.config/PlasmaUserFeedback"

echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# sakura-updates.timer is what makes "updates install overnight" true. It
# was shipped but never enabled, so every machine installed so far has been
# saying that and not doing it.
# cups.socket rather than cups.service: socket activation means the printing
# stack costs nothing until something actually prints. bluetooth.service is
# what bluedevil talks to -- the Plasma page is inert without it.
# Enabled one at a time, and a missing one is reported rather than fatal.
#
# systemctl enable fails the whole list if any single unit is absent, and
# under set -e that ends the install -- leaving a machine with a filesystem, a
# user and no bootloader. That is a far worse outcome than starting without
# one service, and it is exactly what happened when the published repository
# was a version behind and three units were not in the target yet.
for unit in sddm NetworkManager sakura-updates.timer bluetooth.service \
cups.socket snapd.socket sakura-store-updates.timer \
sakura-boot-success.service sakura-aur-campaign-check.timer \
sakura-kernel-sync.service snapper-cleanup.timer \
sakura-mirrors.timer; do
    if ! systemctl enable "\$unit" >/dev/null 2>&1; then
        echo "[sakura-install] warning: could not enable \$unit"
    fi
done
# Per-user timers, same reasoning.
systemctl --global enable sakura-store-updates.timer >/dev/null 2>&1 \
    || echo "[sakura-install] warning: could not enable the per-user update timer"

# Classic snaps look for /snap. Arch puts the mount point at
# /var/lib/snapd/snap, so without this symlink every classic snap fails at
# runtime with paths that do not exist -- and classic is what the large
# proprietary applications people actually want from Snap tend to use.
ln -sfn /var/lib/snapd/snap /snap
# Turn the chosen window into the timer's schedule. Safe to run now: the
# config is already in place from the package's defaults.
/usr/lib/sakura/updates/sakura-updates-schedule >/dev/null 2>&1 || true

# Apply the appearance the user chose. Without this the answer is collected in
# the installer and silently thrown away, and every machine boots dark.
if [ -f "/usr/share/sakura/theme/kdeglobals-$THEME" ]; then
    install -Dm644 "/usr/share/sakura/theme/kdeglobals-$THEME" /etc/xdg/kdeglobals
fi

mkdir -p /boot/EFI/sakura /boot/EFI/BOOT
mkinitcpio -P

# limine goes in the removable-media path so it boots without depending on an
# NVRAM entry surviving. Firmware that forgets its boot order is common enough
# that relying solely on efibootmgr is how a machine becomes unbootable.
cp /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI
cp /usr/share/limine/BOOTX64.EFI /boot/EFI/sakura/limine.efi

# Where the boot watchdog keeps its count. Created here so the first boot
# has somewhere to write, and so sakura-boot-success has something to clear.
install -d /mnt/boot/EFI/sakura/state
echo 0 > /mnt/boot/EFI/sakura/state/boot-count

sakura-boot-entries

# snapper insists on creating /.snapshots itself and refuses when the
# subvolume already exists -- which it does, because the layout puts snapshots
# on their own subvolume so a rollback of @ cannot take them with it. So:
# unmount it, let snapper build its config, throw away the subvolume snapper
# made, and put ours back.
#
# This is deliberately not tolerant of failure. Without a snapper config,
# snap-pac takes no pre-transaction snapshots, and the rollback story -- the
# whole reason for this layout -- silently does not exist.
umount /.snapshots
rmdir /.snapshots
snapper --no-dbus -c root create-config /
btrfs subvolume delete /.snapshots
mkdir /.snapshots
mount /.snapshots
chmod 750 /.snapshots

# ALLOW_GROUPS and SYNC_ACL are what let the desktop show the restore points
# it takes. Without them the Update Center -- which runs unprivileged, on
# purpose -- reads nothing back and tells the user "no restore points yet" on
# a machine that has plenty, which undermines the one guarantee this whole
# design exists to make. Reading the list is not a privileged act; making a
# rollback still is.
# NUMBER_LIMIT is a limit only if something enforces it. snapper prunes when
# snapper-cleanup runs and at no other time, so without that timer -- enabled
# above -- these numbers describe an intention and the snapshots accumulate
# without bound. A restore point per package transaction fills a disk quietly.
snapper --no-dbus -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 \
    NUMBER_LIMIT_IMPORTANT=5 ALLOW_GROUPS=wheel SYNC_ACL=yes
snapper --no-dbus -c root create --description "installation complete" --cleanup-algorithm number
CHROOT

# The password wallet needs no configuration here, and that is worth writing
# down because it looks like it should.
#
# KWallet asking for a password every time an application wants a stored
# secret is the loudest complaint about a KDE desktop, and the advice people
# find is to switch it off -- which puts wifi, Samba and browser passwords
# back in plain text and breaks anything expecting a Secret Service.
#
# The fix is pam_kwallet5, which opens the wallet with the password already
# typed at the login screen. Arch's /etc/pam.d/sddm already carries both
# lines:
#
#   -auth       optional    pam_kwallet5.so
#   -session    optional    pam_kwallet5.so         auto_start
#
# The leading dash is not a comment. In PAM it means "skip this silently if
# the module is not installed", so the lines do nothing on a machine without
# kwallet-pam and take effect the moment there is one. Installing the package
# -- see sakura-desktop -- is the whole of it. Editing this file to add them
# again was written first and thrown away: it produced duplicate entries in
# the login stack, which is a way to be asked twice rather than not at all.

step "Clearing the installation package cache"
# pacstrap leaves every package it installed in the target's cache -- 1.7 GB
# on a normal install, and of no further use: the machine's way back is a
# restore point, not a reinstall from cache.
#
# It also causes a real failure. Our own packages keep the same version
# string across rebuilds, so a copy cached from the install media and a
# differently-built package of the same name on the repository disagree, and
# pacman reports the cached one as corrupt rather than as stale:
#
#   File /var/cache/pacman/pkg/sakura-store-0.1.0-1-any.pkg.tar.zst is
#   corrupted (invalid or corrupted package (checksum))
#
# which is how the first update on a brand new machine failed. The versions
# are stamped per build now as well, so the two cannot collide; this keeps
# the disk space regardless.
rm -f /mnt/var/cache/pacman/pkg/*.pkg.tar.zst \
      /mnt/var/cache/pacman/pkg/*.pkg.tar.zst.sig 2>/dev/null || true

step "Registering with firmware"
efibootmgr --create --disk "$DISK" --part 1 \
    --loader '\EFI\sakura\limine.efi' --label "SakuraOS" --unicode >/dev/null 2>&1 \
    || info "efibootmgr entry not created; the removable path will still boot"

if [[ "$SECUREBOOT" != "off" ]]; then
    step "Secure Boot"
    SETUP_MODE=$(arch-chroot /mnt sbctl status 2>/dev/null | grep -i "setup mode" || true)
    if [[ "$SETUP_MODE" == *"Enabled"* ]]; then
        arch-chroot /mnt /bin/bash -euo pipefail <<'SB'
sbctl create-keys
sbctl enroll-keys --microsoft
sbctl sign -s /boot/EFI/BOOT/BOOTX64.EFI
sbctl sign -s /boot/EFI/sakura/limine.efi
sbctl sign -s /boot/EFI/sakura/sakura.efi
sbctl sign -s /boot/EFI/sakura/sakura-recovery.efi
SB
        info "Secure Boot keys enrolled and boot chain signed"
    else
        info "firmware is not in Setup Mode; skipping Secure Boot enrollment"
        info "the system boots normally with Secure Boot disabled"
    fi
fi

if [[ -z "$ROOTPASS" ]]; then
    info "the root account is locked, as on Ubuntu and Fedora: use sudo."
    info "note that this also makes systemd's emergency console unreachable --"
    info "recovery goes through the Recovery entry in the boot menu instead."
fi

step "Done"
# snapper's create-config leaves the .snapshots subvolume mounted from inside
# the chroot, so the first unmount can find /mnt busy. Sync, retry, and fall
# back to a lazy unmount rather than leaving the caller to guess whether the
# install actually finished writing.
sync
if ! umount -R /mnt 2>/dev/null; then
    sleep 2
    umount -R /mnt 2>/dev/null || umount -Rl /mnt 2>/dev/null || true
fi
sync
info "SakuraOS installed on $DISK"
