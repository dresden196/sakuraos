# /etc/bash.bashrc is the only file an interactive non-login bash reads, and
# a terminal window in a desktop session is exactly that. pacman lists it as a
# backup file, so this edit survives bash upgrades as a .pacnew rather than
# being silently reverted.
_MARKER="# SakuraOS Terminal Assist"

post_install() {
    if ! grep -qF "$_MARKER" etc/bash.bashrc 2>/dev/null; then
        printf '\n%s\n%s\n' "$_MARKER" \
            '[ -r /usr/share/sakura/terminal-assist.sh ] && . /usr/share/sakura/terminal-assist.sh' \
            >> etc/bash.bashrc
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    sed -i "/^${_MARKER}\$/,+1d" etc/bash.bashrc 2>/dev/null || true
}
