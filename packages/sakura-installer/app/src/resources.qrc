<RCC>
  <qresource prefix="/">
    <file>qml/Main.qml</file>
    <file>assets/sakura-mark.png</file>
    <file>assets/browser-zen.png</file>
    <file>assets/browser-firefox.png</file>
    <file>assets/browser-brave.png</file>
    <file>assets/browser-chrome.png</file>
    <file>assets/browser-vivaldi.png</file>
    <file>assets/browser-helium.png</file>
    <!-- Shown on the install progress deck, so the screen somebody sits and
         watches shows the thing each slide is describing. -->
    <file>assets/slide-updates.jpg</file>
    <file>assets/slide-store.jpg</file>
    <!-- Bundled because they are not on the machine: KDE's own logo from
         kde.org's brand assets, and Limine's from its repository. Arch's is
         absent on purpose; it ships in the filesystem package, so it is read
         from disk and matches whatever version the system has.
         (No two consecutive hyphens: XML forbids them inside a comment, and
         rcc rejects the whole file.) -->
    <file>assets/credit-kde.svg</file>
    <file>assets/credit-limine.png</file>
    <file>assets/credit-cachyos.svg</file>
    <file>assets/credit-gnu.png</file>
    <file>assets/credit-linux.svg</file>
    <file>assets/credit-systemd.svg</file>
    <file>assets/credit-btrfs.svg</file>
  </qresource>
</RCC>
