# Maintainer: SakuraOS <dev@sakuraos.invalid>
#
# Appearance, versioned separately from the meta package so the look can change
# without touching anything that affects how the system behaves.
#
# The accent differs between the two schemes, deliberately. The literal cherry
# blossom pink measures 1.60:1 against a light background -- far below the
# 3.0:1 that focus rings and controls need -- but 10.24:1 against a dark one.
# So light uses a deep rose and dark uses the real blossom pink. Both read as
# Sakura; each is legible on its own ground. Decorative pink (wallpaper, login,
# splash, logo) is unconstrained, because contrast rules bind only on text and
# controls.
pkgname=sakura-theme
pkgver=0.2.0
pkgrel=1
pkgdesc="SakuraOS appearance: colour schemes, global themes, defaults"
arch=('any')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
depends=('sddm' 'plasma-desktop' 'sakura-wallpapers' 'breeze' 'breeze-icons')
backup=('etc/sddm.conf.d/20-sakura.conf')
source=('20-sakura.conf' 'kdeglobals' 'kdeglobals-dark' 'kdeglobals-light' 'kwinrulesrc' 'sddm-breeze-theme.conf.user'
        'sakura-pin-browser' '95-sakura-pin-browser.hook'
        '94-sakura-pin-browser-save.hook')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm644 "$srcdir/20-sakura.conf" "$pkgdir/etc/sddm.conf.d/20-sakura.conf"

    # The layout this package ships carries the browser the installer pinned,
    # and pacman replaces the file on upgrade. Putting it in backup= would
    # strand every future theme change behind a .pacnew, so the choice is
    # recorded in /etc/sakura/browser and reapplied by this hook instead.
    install -Dm755 "$srcdir/sakura-pin-browser" "$pkgdir/usr/bin/sakura-pin-browser"
    install -Dm644 "$srcdir/95-sakura-pin-browser.hook" \
        "$pkgdir/usr/share/libalpm/hooks/95-sakura-pin-browser.hook"
    install -Dm644 "$srcdir/94-sakura-pin-browser-save.hook" \
        "$pkgdir/usr/share/libalpm/hooks/94-sakura-pin-browser-save.hook"
    # The greeter's own background. See the file for why it lives here.
    install -Dm644 "$srcdir/sddm-breeze-theme.conf.user" \
        "$pkgdir/usr/share/sddm/themes/breeze/theme.conf.user"

    # Defaults for new users only; a user's own config always wins.
    install -Dm644 "$srcdir/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
    install -Dm644 "$srcdir/kwinrulesrc" "$pkgdir/etc/xdg/kwinrulesrc"
    # Both variants kept so the installer can apply the one the user picked.
    install -Dm644 "$srcdir/kdeglobals-dark"  "$pkgdir/usr/share/sakura/theme/kdeglobals-dark"
    install -Dm644 "$srcdir/kdeglobals-light" "$pkgdir/usr/share/sakura/theme/kdeglobals-light"

    install -d "$pkgdir/usr/share/color-schemes"
    install -m644 "$startdir/color-schemes/"*.colors "$pkgdir/usr/share/color-schemes/"

    # User pictures for the installer's account page. See avatars/ATTRIBUTION.
    install -d "$pkgdir/usr/share/sakura/avatars"
    install -m644 "$startdir/avatars/"*.jpg "$pkgdir/usr/share/sakura/avatars/"
    install -Dm644 "$startdir/avatars/ATTRIBUTION" \
        "$pkgdir/usr/share/licenses/$pkgname/AVATARS-ATTRIBUTION"

    install -d "$pkgdir/usr/share/icons"
    cp -r "$startdir/icons/"* "$pkgdir/usr/share/icons/"

    # Folders in Sakura's colour rather than Breeze's blue.
    #
    # Breeze draws its folders against a stylesheet: every folder icon carries
    # .ColorScheme-Accent and fills from currentColor, so this is one CSS rule
    # substituted per file, not an icon set redrawn. Setting the Plasma accent
    # alone does not do it -- that tints highlights, focus rings and selection,
    # and leaves every folder blue. Verified in a VM before writing this.
    #
    # One rose for both schemes, as Breeze uses one blue for both. The glyph
    # drawn on the folder is near-white in the dark scheme and near-black in
    # the light one, so the body has to sit between them: the blossom pink of
    # the dark accent is too pale to carry a white glyph at 60% opacity.
    local _rose='#e87f9e'
    local _sed="s/color: *#3daee9/color: $_rose/g; s/color: *#3593e6/color: $_rose/g"

    _recolour_dir() {   # breeze theme, our theme, subdirectory
        local src="/usr/share/icons/$1/$3" dst="$pkgdir/usr/share/icons/$2/$3"
        [[ -d "$src" ]] || return 0
        install -d "$dst"
        cp -a "$src/." "$dst/"
        # -type f deliberately: sed follows a symlink to its target, and the
        # relative ones here would take it out of the tree and into Breeze's
        # own files.
        find "$dst" -name '*.svg' -type f -exec sed -i "$_sed" {} +
    }

    _recolour_one() {   # breeze theme, our theme, subdirectory, icon name
        local d size f out
        for d in "/usr/share/icons/$1/$3/"*/; do
            f="$d$4.svg"
            [[ -f "$f" ]] || continue
            size="$(basename "$d")"
            out="$pkgdir/usr/share/icons/$2/$3/$size/$4.svg"
            install -Dm644 "$f" "$out"
            sed -i "$_sed" "$out"
        done
    }

    _recolour_dir breeze-dark SakuraDark  places
    _recolour_dir breeze      SakuraLight places
    # Dolphin's icon is a folder like any other, and left alone it is the one
    # blue thing on a pink taskbar.
    _recolour_one breeze-dark SakuraDark  apps system-file-manager
    _recolour_one breeze      SakuraLight apps system-file-manager
    # A plain directory in a file list is inode-directory from mimetypes, not
    # folder from places -- recolouring places alone leaves every ordinary
    # folder blue while the named ones (Documents, Music) turn pink. Taken by
    # name rather than by directory: it is the only icon in mimetypes that
    # uses this blue, and the rest are file types that should keep theirs.
    _recolour_one breeze-dark SakuraDark  mimetypes inode-directory
    _recolour_one breeze      SakuraLight mimetypes inode-directory

    # index.theme has to list every directory or the loader never looks in it,
    # and what is here is now decided at build time rather than written by
    # hand. Everything above Directories= is kept; the list and the sections
    # below it are regenerated from the tree that actually got installed.
    _reindex() {
        local root="$pkgdir/usr/share/icons/$1" idx rel ctx sz scale
        idx="$root/index.theme"
        local dirs=()
        while IFS= read -r rel; do dirs+=("$rel"); done < <(
            cd "$root" && find . -mindepth 2 -maxdepth 2 \( -type d -o -xtype d \) \
                -printf '%P\n' | sort)
        {
            sed '/^Directories=/,$d' "$idx"
            printf 'Directories=%s\n' "$(IFS=,; printf '%s' "${dirs[*]}")"
            for rel in "${dirs[@]}"; do
                ctx="${rel%%/*}"; sz="${rel##*/}"; scale=1
                case "$sz" in
                    *@2x) scale=2; sz="${sz%@2x}" ;;
                    *@3x) scale=3; sz="${sz%@3x}" ;;
                esac
                printf '\n[%s]\n' "$rel"
                if [[ "$sz" == scalable ]]; then
                    printf 'Size=48\nMinSize=16\nMaxSize=512\nType=Scalable\n'
                else
                    printf 'Size=%s\nType=Fixed\n' "$sz"
                fi
                [[ $scale -gt 1 ]] && printf 'Scale=%s\n' "$scale"
                case "$ctx" in
                    apps)   printf 'Context=Applications\n' ;;
                    places)    printf 'Context=Places\n' ;;
                    mimetypes) printf 'Context=MimeTypes\n' ;;
                esac
            done
        } > "$idx.new"
        mv "$idx.new" "$idx"
    }
    # Dolphin ships its own icon in hicolor with the blue written into the
    # drawing rather than read from a stylesheet, so it survives everything
    # above and stays the one blue mark on a pink taskbar. Two shades kept as
    # two: flattened to one, the fold in the folder disappears.
    #
    # This is the only application icon we repaint that is not ours. It is a
    # folder, it sits next to fifteen other folders, and leaving it blue was
    # the thing that got noticed.
    _dolphin() {
        local src=/usr/share/icons/hicolor/scalable/apps/org.kde.dolphin.svg
        local out="$pkgdir/usr/share/icons/$1/apps/scalable/org.kde.dolphin.svg"
        [[ -f "$src" ]] || return 0
        install -Dm644 "$src" "$out"
        sed -i 's/#3593e6/#e87f9e/g; s/#147cdc/#c25674/g' "$out"
    }
    _dolphin SakuraDark
    _dolphin SakuraLight

    _reindex SakuraDark
    _reindex SakuraLight

    install -d "$pkgdir/usr/share/plasma/look-and-feel"
    cp -r "$startdir/look-and-feel/"* "$pkgdir/usr/share/plasma/look-and-feel/"
    find "$pkgdir/usr/share/plasma/look-and-feel" -type f -exec chmod 644 {} +
    find "$pkgdir/usr/share/plasma/look-and-feel" -type d -exec chmod 755 {} +
}
