#!/usr/bin/env python3
"""Put the browser this machine chose back on the task bar.

The panel is built from our look-and-feel layout the first time a user logs in,
and that layout carries a short hardcoded list of launchers. The installer edits
it to add whichever browser was chosen, because a browser is the one application
a new machine is certain to need in its first minute.

That edit was being lost. The layout is a file shipped by sakura-theme and it is
not in the package's backup array, so pacman replaced it on every theme upgrade
and took the pin with it -- silently, and with no way for anyone to notice until
the next new user on that machine got a panel with no browser on it. Putting the
layout in backup= instead would strand every future theme change behind a
.pacnew on every machine, which is a worse trade.

So the choice is recorded in /etc/sakura/browser and reapplied from here by a
pacman hook after anything rewrites the layout. Idempotent by checking for the
entry before adding it, so running it when nothing needs doing is free.
"""
from __future__ import annotations

import glob
import subprocess
import sys
from pathlib import Path

CHOICE = Path("/etc/sakura/browser")
LAYOUTS = "/usr/share/plasma/look-and-feel/org.sakura.*.desktop/contents/layouts/org.kde.plasma.desktop-layout.js"
# Before Konsole: file manager, browser, store, terminal is the order of how
# often somebody new reaches for each.
NEEDLE = '"applications:org.kde.konsole.desktop",'


def desktop_entry(package: str) -> str | None:
    """The .desktop file that package ships, read from the package itself.

    Not a lookup table: brave-bin ships brave-browser.desktop, vivaldi ships
    vivaldi-stable.desktop and google-chrome ships com.google.Chrome.desktop,
    and a table of those is wrong the first time any of them renames a file.
    """
    try:
        out = subprocess.run(["pacman", "-Ql", package],
                             capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    for line in out.splitlines():
        parts = line.split(maxsplit=1)
        if len(parts) != 2:
            continue
        path = parts[1].strip()
        if path.startswith("/usr/share/applications/") and path.endswith(".desktop"):
            return Path(path).name
    return None


def owning_package(entry: str) -> str | None:
    """Which package ships /usr/share/applications/<entry>."""
    try:
        out = subprocess.run(["pacman", "-Qoq", f"/usr/share/applications/{entry}"],
                             capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    return out.strip().splitlines()[0] if out.strip() else None


def migrate() -> int:
    """Recover the choice on a machine installed before it was recorded.

    Installs made before /etc/sakura/browser existed have the browser in the
    layout and nowhere else, so the first theme upgrade would drop it with
    nothing to put back. This runs before the layout is replaced and works out
    which of its launchers is the browser.

    Identified by the desktop entry declaring the WebBrowser category, which is
    what the category is for -- not by matching names against a list of the
    browsers we happen to ship today.
    """
    if CHOICE.is_file() and CHOICE.read_text().strip():
        return 0                      # already recorded; nothing to work out
    for path in glob.glob(LAYOUTS):
        for line in Path(path).read_text().splitlines():
            marker = '"applications:'
            if marker not in line:
                continue
            entry = line.split(marker, 1)[1].split('"', 1)[0]
            desktop = Path("/usr/share/applications") / entry
            if not desktop.is_file():
                continue
            try:
                content = desktop.read_text(errors="replace")
            except OSError:
                continue
            categories = ""
            for l in content.splitlines():
                if l.startswith("Categories="):
                    categories = l
                    break
            if "WebBrowser" not in categories:
                continue
            package = owning_package(entry)
            if not package:
                continue
            CHOICE.parent.mkdir(parents=True, exist_ok=True)
            CHOICE.write_text(package + "\n")
            print(f"sakura-pin-browser: recorded {package} as this machine's browser")
            return 0
    return 0


def main() -> int:
    if "--migrate" in sys.argv:
        return migrate()

    if not CHOICE.is_file():
        return 0                      # nothing was chosen; nothing to restore
    package = CHOICE.read_text().strip()
    if not package:
        return 0

    entry = desktop_entry(package)
    if entry is None:
        # The browser was removed since the install. Not an error: the machine
        # is allowed to change, and re-adding a launcher for something that is
        # gone would put a broken icon on the panel.
        return 0

    launcher = f'"applications:{entry}",'
    changed = 0
    for path in glob.glob(LAYOUTS):
        text = Path(path).read_text()
        if launcher in text:
            continue
        if NEEDLE not in text:
            print(f"sakura-pin-browser: {path} no longer has the expected "
                  f"launcher list; leaving it alone", file=sys.stderr)
            continue
        at = text.index(NEEDLE)
        indent = " " * (at - text.rindex("\n", 0, at) - 1)
        Path(path).write_text(text.replace(NEEDLE, f'{launcher}\n{indent}{NEEDLE}', 1))
        changed += 1

    if changed:
        print(f"sakura-pin-browser: restored {entry} on {changed} layout(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
