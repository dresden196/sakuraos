[Icon Theme]
Name=Sakura Light
Comment=Breeze, with SakuraOS's own application icons
# Inherits rather than replaces. A complete icon set is tens of thousands of
# drawings; claiming one by renaming Breeze would be a lie and a maintenance
# burden. What is here is only what is ours to draw -- our four applications
# and the mark -- and everything else defers to a set that is complete and
# maintained. Breeze's monochrome icons already follow the active colour
# scheme, so they take SakuraDark's palette without being copied.
Inherits=breeze,hicolor
Directories=apps/scalable,apps/16,apps/22,apps/24,apps/32,apps/48,apps/64

[apps/scalable]
Size=48
Context=Applications
Type=Scalable
MinSize=16
MaxSize=512

[apps/16]
Size=16
Context=Applications
Type=Fixed

[apps/22]
Size=22
Context=Applications
Type=Fixed

[apps/24]
Size=24
Context=Applications
Type=Fixed

[apps/32]
Size=32
Context=Applications
Type=Fixed

[apps/48]
Size=48
Context=Applications
Type=Fixed

[apps/64]
Size=64
Context=Applications
Type=Fixed
