# System-wide Plasma defaults for new users.
#
# Only defaults: anything a user changes lands in their own ~/.config and wins
# over this. Changing an existing user's look on an update reads as a bug, so
# nothing here is ever pushed onto a configured account.
[General]
AccentColor=224,100,140
accentColorFromWallpaper=false
ColorScheme=SakuraLight
widgetStyle=Breeze

[KDE]
widgetStyle=Breeze
LookAndFeelPackage=org.sakura.light.desktop
# The pair System Settings offers under Quick Settings, and switches between
# on "Automatic". Unset, it offered stock Breeze and Breeze Dark, so choosing
# light or dark there threw the SakuraOS look away.
DefaultLightLookAndFeel=org.sakura.light.desktop
DefaultDarkLookAndFeel=org.sakura.dark.desktop

[Icons]
Theme=SakuraLight
