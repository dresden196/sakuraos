# The freedesktop menu categories. Flathub serves them at
# /collection/category/<Name> and archlinux-appstream-data tags repository
# packages with exactly the same names, so one vocabulary covers both sources.
# The AUR has no categories at all and Snap uses its own taxonomy; neither is
# invented here, they are simply absent from the category view.
CATEGORIES = [
    ("Graphics", "Graphics & Photography"),
    ("AudioVideo", "Audio & Video"),
    ("Development", "Developer Tools"),
    ("Game", "Games"),
    ("Network", "Internet"),
    ("Office", "Productivity"),
    ("Education", "Education & Science"),
    ("System", "System"),
    ("Utility", "Utilities"),
]


def category(name: str, limit: int = 24) -> list[App]:
    """One category, from every source that has a notion of categories."""
    groups: list[list[App]] = []

    flat = [s for s in SOURCES if s.name == "flatpak"][0]
    if flat.available():
        data = fetch(f"{FLATHUB_API}/collection/category/{urllib.parse.quote(name)}"
                     f"?page=1&per_page={limit}", {}, tag="Flathub")
        groups.append(flat.apps_from_hits(data.get("hits", []), limit))

    repo = RepoSource()
    if repo.available():
        have = repo.installed()
        index = appstream_index()
        hits = []
        for pkg, meta in index.items():
            if meta.get("kind") != "desktop-application":
                continue
            if name not in meta.get("categories", []):
                continue
            hits.append(App(id=meta["id"], name=meta["name"],
                            summary=meta.get("summary", ""),
                            developer=meta.get("developer", ""),
                            icon=meta.get("icon", ""),
                            source="repo", source_id=pkg,
                            installed=pkg in have,
                            version=have.get(pkg, "")))
        hits.sort(key=lambda a: a.name.lower())
        groups.append(hits[:limit])

    apps = merge(groups)
    attach_ratings(apps)
    # Rated things first: within a category, what other people rated is a
    # better opening order than the alphabet.
    apps.sort(key=lambda a: (-(a.rating_count or 0), a.name.lower()))
    return apps[:limit]


def collection(name: str, limit: int = 12) -> list[App]:
    """A real Flathub collection: popular, trending, recently-updated.

    The front page previously ran a search for the word "editor" and labelled
    the result "Popular right now", which was simply untrue. These endpoints
    are what Flathub actually ranks by.
    """
    data = fetch(f"{FLATHUB_API}/collection/{name}?page=1&per_page={limit}",
                 {}, tag="Flathub")
    hits = (data.get("hits") if isinstance(data, dict) else None) or []
    have = FlatpakSource().installed()
    out = []
    for h in hits:
        app_id = h.get("app_id") or h.get("id") or ""
        if not app_id:
            continue
        out.append(App(
            id=app_id, name=h.get("name") or app_id,
            summary=h.get("summary") or "",
            developer=h.get("developer_name") or "",
            icon=h.get("icon") or "",
            source="flatpak", source_id=app_id,
            installed=app_id in have, version=have.get(app_id, ""),
            popularity={"installs": h.get("installs_last_month")}
                        if h.get("installs_last_month") else {},
        ))
    return out


def pacman_version(pkg: str) -> str:
    """The repository version of a package that is not installed."""
    for line in run(["pacman", "-Si", pkg]).splitlines():
        if line.startswith("Version"):
            return line.split(":", 1)[1].strip()
    return ""


def find_elsewhere(app_id: str, name: str) -> list[dict]:
    """The same application from other sources.

    Namespaces do not line up -- Flatpak uses reverse-DNS, the AUR and Snap
    use bare names -- so the last component of the id is tried alongside the
    display name. This is a heuristic and is presented as one: the app page
    offers what it found rather than asserting they are the same build.
    """
    stem = app_id.rsplit(".", 1)[-1].lower()
    words = {stem, name.lower().split()[0]} if name else {stem}
    found = []

    # The repositories are not a guess: AppStream gives their packages the same
    # component id Flathub uses, so this is an exact lookup rather than a
    # search for a similar-looking name.
    repo = RepoSource()
    matched_repo = False
    if repo.available():
        target = norm_id(app_id)
        for pkg, meta in appstream_index().items():
            if norm_id(meta["id"]) != target:
                continue
            have = repo.installed()
            found.append({"source": "repo", "id": pkg,
                          "version": have.get(pkg) or pacman_version(pkg),
                          "installed": pkg in have, "popularity": {},
                          "exact": True})
            matched_repo = True
            break

    for src in SOURCES:
        # Not every repository package has a reverse-DNS id -- Arch files
        # Discord under "discord.desktop", which no normalisation can turn
        # into com.discordapp.Discord -- so when the exact lookup misses, the
        # repositories go through the same name heuristic as everything else.
        if src.name == "flatpak" or (src.name == "repo" and matched_repo):
            continue
        if not src.available():
            continue
        try:
            for hit in src.search(stem):
                if hit.source_id.lower() in words or hit.name.lower() in words:
                    found.append({"source": src.name, "id": hit.source_id,
                                  "version": hit.version,
                                  "installed": hit.installed,
                                  "popularity": hit.popularity,
                                  "exact": False})
                    break
        except Exception:
            continue
    return found


def app_detail(app_id: str) -> dict:
    """Everything the app page needs, in one call.

    Flathub carries the screenshots, the description, the licence and the
    developer's own brand colours. Using the last of those means an app page
    looks like the application rather than like a row in a database.
    """
    d = fetch(f"{FLATHUB_API}/appstream/{app_id}", {}, tag="Flathub") or {}
    if not d:
        return {}

    shots = []
    for sc in (d.get("screenshots") or []):
        sizes = sc.get("sizes") or []
        # Largest available, because these are shown full width and an
        # upscaled 624px thumbnail looks worse than no screenshot at all.
        best = max(sizes, key=lambda x: int(x.get("width") or 0), default=None)
        if best and best.get("src"):
            shots.append({"url": best["src"], "caption": sc.get("caption") or ""})

    brand = ""
    for b in (d.get("branding") or []):
        if b.get("scheme_preference") in ("dark", None) and b.get("value"):
            brand = b["value"]
            if b.get("scheme_preference") == "dark":
                break

    # The same lookup the search results use -- it was duplicated here with the
    # first-match bug, so the app page and the tile could disagree.
    rating, count = rating_for(app_id)

    installed_here = FlatpakSource().installed()

    releases = d.get("releases") or []
    latest = releases[0] if releases else {}

    return {
        "id": app_id,
        "installed": app_id in installed_here,
        # The version installed, and the version on offer. Showing only one of
        # them leaves the user unable to tell whether they are behind.
        "installed_version": installed_here.get(app_id, ""),
        "version": latest.get("version") or "",
        "released": latest.get("timestamp") or 0,
        "source": (d.get("bundle") or {}).get("type") or "flatpak",
        "also_from": find_elsewhere(app_id, d.get("name") or ""),
        "name": d.get("name") or app_id,
        "summary": d.get("summary") or "",
        # Flathub returns HTML; the interface renders it rather than showing
        # tags, so it is passed through unchanged.
        "description": d.get("description") or "",
        "developer": d.get("developer_name") or "",
        "license": d.get("project_license") or "",
        "icon": d.get("icon") or "",
        "brand": brand,
        "screenshots": shots,
        "urls": d.get("urls") or {},
        "rating": rating,
        "rating_count": count,
        "reviews": odrs_reviews(app_id),
    }


def odrs_reviews(app_id: str, limit: int = 8) -> list:
    """Recent reviews for one app.

    Posted and read by GNOME Software and Discover as well, so this is the
    same conversation rather than a private one we started.
    """
    body = {"app_id": f"{app_id}.desktop", "locale": "en_GB",
            "distro": "SakuraOS", "limit": limit,
            "user_hash": "0" * 40, "version": "1.0"}
    data = fetch(f"{ODRS_API}/fetch", [], post=body, tag="ODRS")
    out = []
    for r in (data or [])[:limit]:
        out.append({
            "summary": r.get("summary") or "",
            "text": r.get("description") or "",
            "rating": (r.get("rating") or 0) // 20,   # ODRS stores 0-100
            "author": r.get("user_display") or "Anonymous",
            "date": r.get("date_created") or 0,
            "version": r.get("version") or "",
        })
    return out


