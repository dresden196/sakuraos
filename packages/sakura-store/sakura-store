def cmd_sources(args) -> int:
    """Every source, present or not, and why not.

    Sources that are switched off or absent are still listed. Hiding them
    means a person cannot discover that the AUR exists, let alone that it is
    theirs to switch on -- the filter simply vanishes with no explanation.
    """
    def why(src) -> str:
        if src.available():
            return ""
        if src.name == "aur":
            return "Switched off in SakuraOS Settings"
        if src.name == "snap":
            return "snapd is not installed"
        return "Not available on this machine"

    rows = [{"id": s.name, "label": s.label, "available": s.available(),
             "reason": why(s),
             # Searchable but not installable, until the review step exists.
             "installable": s.name != "aur"}
            for s in SOURCES]
    # AppImage has no catalogue to search, so it is not a source in the sense
    # the others are; it appears here only so the UI can say why.
    rows.append({"id": "appimage", "label": "AppImage", "available": False,
                 "reason": "No catalogue to search — AppImages install from a file or a link",
                 "installable": True})
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for r in rows:
        print(f"  {r['id']:<9} {r['label']:<14} "
              f"{'available' if r['available'] else 'unavailable'}")
    return 0


def cmd_search(args) -> int:
    wanted = [s for s in SOURCES
              if (not args.source or s.name == args.source) and s.available()]
    groups = [s.search(args.query) for s in wanted]
    apps = merge(groups)
    attach_ratings(apps)

    apps.sort(key=lambda a: (a.rating_count, a.popularity.get("installs", 0)), reverse=True)

    if args.json:
        print(json.dumps({"apps": [asdict(a) for a in apps],
                          "unavailable": FAILURES}, indent=2))
        return 0

    if not apps:
        print("Nothing found.")
    for tag, why in FAILURES.items():
        print(f"  ({tag} could not be reached: {why})")
    if not apps:
        return 0
    for a in apps[:20]:
        line = f"  {a.name}"
        if a.rating:
            line += f"   {a.rating}★ ({a.rating_count})"
        print(line)
        if a.summary:
            print(f"      {a.summary[:74]}")
        extra = ", ".join(x["source"] for x in a.also_from)
        print(f"      {a.source}" + (f" · also {extra}" if extra else "")
              + (f" · installed" if a.installed else ""))
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="sakura-store", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search")
    s.add_argument("query")
    s.add_argument("--source")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_search)

    v = sub.add_parser("sources")
    v.add_argument("--json", action="store_true")
    v.set_defaults(fn=cmd_sources)

    i = sub.add_parser("install")
    # Optional for a local AppImage, which is named after the file.
    i.add_argument("id", nargs="?", default="")
    i.add_argument("--source", required=True)
    i.add_argument("--url", help="for appimage: download it from here")
    i.add_argument("--file", help="for appimage: install this local file")
    i.add_argument("--sha256", help="for appimage")
    i.set_defaults(fn=cmd_install)

    rp = sub.add_parser("remove-plan")
    rp.add_argument("id")
    rp.add_argument("--source", required=True)
    rp.add_argument("--json", action="store_true")
    rp.set_defaults(fn=cmd_remove_plan)

    r = sub.add_parser("remove")
    r.add_argument("id")
    r.add_argument("--source", required=True)
    r.add_argument("--delete-data", action="store_true",
                   help="also remove the application's settings and data")
    r.set_defaults(fn=cmd_remove)

    cats = sub.add_parser("categories")
    cats.add_argument("--json", action="store_true")
    cats.set_defaults(fn=cmd_categories)

    cat = sub.add_parser("category")
    cat.add_argument("name", choices=[k for k, _ in CATEGORIES])
    cat.add_argument("--limit", type=int, default=24)
    cat.add_argument("--json", action="store_true")
    cat.set_defaults(fn=cmd_category)

    c = sub.add_parser("collection")
    c.add_argument("name", choices=["popular", "trending",
                                    "recently-updated", "recently-added"])
    c.add_argument("--limit", type=int, default=12)
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_collection)

    n = sub.add_parser("info")
    n.add_argument("id")
    n.add_argument("--json", action="store_true")
    n.set_defaults(fn=cmd_info)

    up = sub.add_parser("updates", help="what has a newer version")
    up.add_argument("--json", action="store_true")
    up.set_defaults(fn=cmd_updates)

    ap = sub.add_parser("update", help="install newer versions")
    ap.add_argument("--id", help="just this one")
    ap.add_argument("--source", help="just this source")
    # Passed by the timer, never by a person: it is what makes the settings
    # apply, and what keeps anything needing a password out of the way.
    ap.add_argument("--unattended", action="store_true")
    ap.add_argument("--scope", choices=["system", "user"],
                    help="which half of an unattended run this is")
    ap.set_defaults(fn=cmd_update)

    ex = sub.add_parser("export-list", help="write the installed app list")
    ex.add_argument("--output", default="-")
    ex.set_defaults(fn=cmd_export_list)

    rd = sub.add_parser("read-list", help="say what an app list would install")
    rd.add_argument("file")
    rd.set_defaults(fn=cmd_read_list)

    l = sub.add_parser("installed")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_installed)

    args = p.parse_args()
    try:
        return args.fn(args)
    except Exception as exc:
        # A traceback on stdout is not JSON, so the UI parsed nothing and drew
        # an empty page -- the store looked broken with no indication of why.
        # Anything unhandled is reported in the shape the caller expects, and
        # the detail still goes to stderr for a person reading the log.
        import traceback
        traceback.print_exc()
        # install and remove speak a line-of-JSON progress protocol, so a
        # failure has to arrive in that shape or the caller sees a process
        # that exited with nothing to say.
        if args.cmd in ("install", "remove"):
            print(json.dumps({"stage": "failed",
                              "error": f"{type(exc).__name__}: {exc}",
                              "recoverable": False}), flush=True)
        elif getattr(args, "json", False):
            print(json.dumps({
                "apps": [], "unavailable": dict(
                    FAILURES, engine=f"{type(exc).__name__}: {exc}"),
            }))
        else:
            print(f"  the store failed: {type(exc).__name__}: {exc}",
                  file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
