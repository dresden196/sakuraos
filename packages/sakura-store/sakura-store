#!/usr/bin/env python3
"""SakuraOS app store engine.

Sources are an interface, not special cases. Flatpak, Snap, AppImage, the AUR
and the system repositories all answer the same small contract, so adding a
source -- including a Sakura-hosted one later -- means implementing that
contract rather than editing the interface.

  sakura-store search <query>     across every enabled source
  sakura-store info <id>          detail, ratings, and where else it exists
  sakura-store install <id>
  sakura-store list               what is installed, and from where
"""
from __future__ import annotations

import argparse
import gzip
import json
import os
import re
import subprocess
import time
import sys
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from functools import lru_cache
from dataclasses import dataclass, asdict, field
from pathlib import Path

# Installed beside the engine rather than on the default path, so the import
# has to be told where to look.
sys.path.insert(0, "/usr/lib/sakura/store")

CONFIG = Path(os.environ.get("SAKURA_CONFIG", "/etc/sakura/sakura.conf"))
# Per user, not /var/cache. The store runs as whoever is logged in, and a
# system-wide path means the first command run as root leaves root-owned files
# that the user can then neither read nor replace -- which is exactly what
# happened: one `sakura-store install` as root and every page went blank.
CACHE = Path(os.environ.get("SAKURA_STORE_CACHE")
             or os.environ.get("XDG_CACHE_HOME")
             and f"{os.environ['XDG_CACHE_HOME']}/sakura/store"
             or os.path.expanduser("~/.cache/sakura/store"))

FLATHUB_API = "https://flathub.org/api/v2"
ODRS_API = "https://odrs.gnome.org/1.0/reviews/api"
AUR_RPC = "https://aur.archlinux.org/rpc/v5"
TIMEOUT = 20


# Sources that failed this run, so the difference between "nothing matched"
# and "we could not ask" can be reported. Silent degradation is how a store
# ends up showing an empty list and calling it an answer -- which is the
# behaviour this store exists to be better than.
FAILURES: dict[str, str] = {}


def fetch(url: str, default=None, *, post: dict | None = None, tag: str = "",
          headers: dict | None = None):
    """Ask a service, degrade if it is unreachable, and record that it was.

    An outage at Flathub must not take AUR results down with it, but it must
    also not be indistinguishable from Flathub having no matches.
    """
    try:
        data = json.dumps(post).encode() if post is not None else None
        req = urllib.request.Request(
            url, data=data,
            headers={"User-Agent": "sakura-store/0.1",
                     **({"Content-Type": "application/json"} if data else {}),
                     **(headers or {})})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        FAILURES[tag or url] = f"HTTP {e.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        FAILURES[tag or url] = f"unreachable ({type(e).__name__})"
    except ValueError:
        FAILURES[tag or url] = "unreadable response"
    return default


def run(args: list[str]) -> str:
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


@dataclass
class App:
    id: str                       # canonical id, the Flatpak style where known
    name: str
    summary: str = ""
    developer: str = ""
    icon: str = ""
    source: str = ""              # which source this particular result came from
    source_id: str = ""           # the id THAT source knows it by
    installed: bool = False
    version: str = ""
    # Reviews and popularity are kept apart on purpose: a star average and an
    # install count are not the same kind of number and must never be blended.
    rating: float | None = None
    rating_count: int = 0
    popularity: dict = field(default_factory=dict)
    also_from: list = field(default_factory=list)


# --------------------------------------------------------------------------
# sources
# --------------------------------------------------------------------------
class Source:
    """The whole contract. A new source implements these four."""
    name = ""
    label = ""

    def available(self) -> bool:
        raise NotImplementedError

    def search(self, query: str) -> list[App]:
        raise NotImplementedError

    def installed(self) -> dict[str, str]:
        """source_id -> version, for everything this source has installed."""
        return {}

    def installed_apps(self) -> dict[str, str]:
        """The subset a person would call an application.

        For every source but the repositories these are the same set, because
        a Flatpak or a Snap is always an application. Native packages are not.
        """
        return self.installed()

    def display_names(self) -> dict[str, str]:
        """source_id -> the name to show a person.

        Flatpak ids are reverse-DNS, so an installed list built from ids alone
        reads as app.zen_browser.zen rather than Zen Browser.
        """
        return {}

    def local_icons(self) -> dict[str, str]:
        """source_id -> a path to an icon already on this machine.

        The Installed list must render with no network: it is the one view a
        person opens when something is wrong.
        """
        return {}


class FlatpakSource(Source):
    name = "flatpak"
    label = "Flathub"

    def available(self) -> bool:
        return bool(run(["flatpak", "--version"]))

    def display_names(self) -> dict[str, str]:
        out = run(["flatpak", "list", "--app", "--columns=application,name"])
        names = {}
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) == 2 and parts[0]:
                names[parts[0]] = parts[1]
        return names

    def local_icons(self) -> dict[str, str]:
        # flatpak keeps the remote's AppStream icons unpacked under
        # /var/lib/flatpak/appstream/<remote>/<arch>/active/icons/.
        icons: dict[str, str] = {}
        base = Path("/var/lib/flatpak/appstream")
        if not base.is_dir():
            return icons
        for size in ("128x128", "64x64"):
            for d in base.glob(f"*/*/active/icons/{size}"):
                for f in d.glob("*.png"):
                    icons.setdefault(f.stem, f"file://{f}")
        return icons

    def installed(self) -> dict[str, str]:
        out = run(["flatpak", "list", "--app", "--columns=application,version"])
        found = {}
        for line in out.splitlines():
            parts = line.split("\t")
            if parts and parts[0]:
                found[parts[0].strip()] = (parts[1].strip() if len(parts) > 1 else "")
        return found

    def search(self, query: str) -> list[App]:
        data = fetch(f"{FLATHUB_API}/search", {}, post={"query": query}, tag="Flathub")
        hits = data.get("hits", []) if isinstance(data, dict) else []
        return self.apps_from_hits(hits)

    def apps_from_hits(self, hits: list, limit: int = 40) -> list[App]:
        """Flathub returns the same hit shape from search and from every
        collection endpoint, so one converter serves both."""
        have = self.installed()
        out = []
        for h in hits[:limit]:
            app_id = h.get("app_id") or h.get("id") or ""
            if not app_id:
                continue
            out.append(App(
                id=app_id,
                name=h.get("name") or app_id,
                summary=h.get("summary") or "",
                developer=h.get("developer_name") or "",
                icon=h.get("icon") or "",
                source=self.name,
                source_id=app_id,
                installed=app_id in have,
                version=have.get(app_id, ""),
                popularity={"installs": h.get("installs_last_month")}
                            if h.get("installs_last_month") else {},
            ))
        return out


# --------------------------------------------------------------------------
# AppStream metadata for repository packages
# --------------------------------------------------------------------------
# pacman knows a package's name and description and nothing else -- no icon,
# no display name, no upstream id. archlinux-appstream-data carries all of it,
# and crucially it gives repository packages the SAME component id Flathub
# uses (gimp in extra is org.gimp.GIMP), which turns cross-source matching
# from a guess about package names into an identity.
SWCATALOG = Path("/usr/share/swcatalog")


def norm_id(app_id: str) -> str:
    """Compare AppStream ids across catalogues.

    The same application is filed under ids that differ in ways that carry no
    meaning: Arch calls Steam com.valvesoftware.Steam.desktop where Flathub
    calls it com.valvesoftware.Steam, and Arch's VLC is org.videolan.vlc
    against Flathub's org.videolan.VLC. Trailing .desktop and case are noise.
    """
    out = app_id.strip().lower()
    if out.endswith(".desktop"):
        out = out[: -len(".desktop")]
    return out


def _untagged(component, tag: str) -> str:
    """The element with no xml:lang, i.e. the source-language one.

    The catalogue ships every translation as a sibling element, so findtext()
    returns whichever locale happens to come first -- for GIMP that is Arabic.
    """
    for el in component.findall(tag):
        if not el.get("{http://www.w3.org/XML/1998/namespace}lang"):
            return (el.text or "").strip()
    return ""


@lru_cache(maxsize=1)
def appstream_index() -> dict[str, dict]:
    """pkgname -> metadata, merged across the repository catalogues."""
    index: dict[str, dict] = {}
    xmldir = SWCATALOG / "xml"
    if not xmldir.is_dir():
        return index
    for path in sorted(xmldir.glob("*.xml.gz")):
        origin = path.name[: -len(".xml.gz")]
        try:
            with gzip.open(path, "rb") as fh:
                root = ET.parse(fh).getroot()
        except Exception as exc:                     # a corrupt catalogue must
            FAILURES["appstream"] = str(exc)         # not take the search down
            continue
        for c in root.findall("component"):
            pkg = c.findtext("pkgname")
            if not pkg or pkg in index:
                continue
            kind = c.get("type") or ""
            icon = ""
            # Prefer the largest cached icon; "stock" icons name a theme icon
            # we would have to resolve ourselves and often do not have.
            best = 0
            for el in c.findall("icon"):
                if el.get("type") != "cached":
                    continue
                w = int(el.get("width") or 0)
                if w >= best:
                    best, icon = w, str(
                        SWCATALOG / "icons" / f"archlinux-arch-{origin}"
                        / f"{w}x{w}" / (el.text or "").strip())
            # A local path is not a URL. Qt resolves a bare absolute path
            # against the component's base URL -- qrc:/ -- and draws nothing.
            icon_url = f"file://{icon}" if icon and Path(icon).exists() else ""
            dev = _untagged(c, "developer_name")
            if not dev:
                node = c.find("developer")
                if node is not None:
                    dev = _untagged(node, "name")
            index[pkg] = {
                "kind": kind,
                "categories": [e.text for e in c.findall("categories/category")
                               if e.text],
                "id": c.findtext("id") or pkg,
                "name": _untagged(c, "name") or pkg,
                "summary": _untagged(c, "summary"),
                "developer": dev,
                "license": c.findtext("project_license") or "",
                "icon": icon_url,
            }
    return index


class RepoSource(Source):
    """Arch's own repositories.

    The most obviously missing source on an Arch-based distribution: GIMP,
    for one, is in extra and not in the AUR at all, so a store without this
    simply could not find it. Reviewed, signed, built against the system
    libraries, and updated by the same engine that handles everything else --
    which is why the documented priority puts it ahead of Flatpak.
    """
    name = "repo"
    label = "SakuraOS"

    def available(self) -> bool:
        return bool(run(["pacman", "--version"]))

    def installed(self) -> dict[str, str]:
        out = run(["pacman", "-Qn"])
        return {l.split()[0]: l.split()[1]
                for l in out.splitlines() if len(l.split()) == 2}

    def installed_apps(self) -> dict[str, str]:
        """Only the applications, not the operating system.

        installed() has to answer "is this package present" for every package,
        dependencies included, so the search results can be marked correctly.
        The Installed list is a different question: -Qn returns all ~1000
        native packages, so without this the tab lists glibc and systemd
        beside the user's actual applications. Explicitly-installed packages
        that have an AppStream component are the applications.
        """
        out = run(["pacman", "-Qen"])
        index = appstream_index()
        return {p[0]: p[1] for p in (l.split() for l in out.splitlines())
                if len(p) == 2
                and index.get(p[0], {}).get("kind") == "desktop-application"}

    def search(self, query: str) -> list[App]:
        out = run(["pacman", "-Ss", query])
        have = self.installed()
        apps: list[App] = []
        header = None
        for line in out.splitlines():
            if not line.startswith((" ", "\t")):
                # "extra/gimp 3.2.4-2 [installed]"
                parts = line.split()
                if not parts or "/" not in parts[0]:
                    header = None
                    continue
                repo, _, pkg = parts[0].partition("/")
                meta = appstream_index().get(pkg, {})
                header = App(
                    # The AppStream id where there is one: it is the same id
                    # Flathub uses, so an app that exists in both places is
                    # recognised as one app rather than matched by name.
                    id=meta.get("id") or pkg,
                    name=meta.get("name") or pkg,
                    summary=meta.get("summary", ""),
                    developer=meta.get("developer") or repo,
                    icon=meta.get("icon", ""),
                    source=self.name, source_id=pkg,
                    installed=pkg in have,
                    version=have.get(pkg) or (parts[1] if len(parts) > 1 else ""),
                )
                apps.append(header)
            elif header is not None:
                # pacman's own description is the fallback for the ~90% of
                # packages that ship no AppStream component at all.
                if not header.summary:
                    header.summary = line.strip()
                header = None
        # pacman -Ss matches descriptions too, so a bare query can return
        # hundreds. Name matches first, then the rest.
        q = query.lower()
        index = appstream_index()
        apps.sort(key=lambda a: (
            a.source_id not in index,        # applications before plumbing
            q not in a.source_id.lower(),    # then name matches before description ones
            a.source_id))
        return apps[:25]


class AurSource(Source):
    name = "aur"
    label = "AUR"

    def available(self) -> bool:
        # Gated on the setting, not on whether the network works. The AUR being
        # switched off is a decision the user made, and results must not
        # reappear because a config file failed to parse.
        return read_config().get("AUR", {}).get("Enabled", "false") == "true"

    def installed(self) -> dict[str, str]:
        out = run(["pacman", "-Qm"])
        return {l.split()[0]: l.split()[1] for l in out.splitlines() if len(l.split()) == 2}

    def installed_apps(self) -> dict[str, str]:
        # -debug packages are split output that only a debugger consumes;
        # listing yay-debug beside yay in a store is noise.
        return {k: v for k, v in self.installed().items()
                if not k.endswith("-debug")}

    def search(self, query: str) -> list[App]:
        data = fetch(f"{AUR_RPC}/search/{urllib.parse.quote(query)}", {}, tag="AUR")
        results = data.get("results", []) if isinstance(data, dict) else []
        have = self.installed()
        results.sort(key=lambda r: r.get("NumVotes", 0), reverse=True)
        out = []
        for r in results[:25]:
            n = r.get("Name", "")
            out.append(App(
                id=n,
                name=n,
                summary=r.get("Description") or "",
                developer=r.get("Maintainer") or "",
                source=self.name,
                source_id=n,
                installed=n in have,
                version=have.get(n, r.get("Version", "")),
                popularity={"votes": r.get("NumVotes", 0)},
            ))
        return out


class SnapSource(Source):
    name = "snap"
    label = "Snap Store"

    def available(self) -> bool:
        return bool(run(["snap", "version"]))

    def installed(self) -> dict[str, str]:
        out = run(["snap", "list"])
        found = {}
        for line in out.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 2:
                found[parts[0]] = parts[1]
        return found

    def search(self, query: str) -> list[App]:
        data = fetch(
            "https://api.snapcraft.io/v2/snaps/find?q=" + urllib.parse.quote(query)
            # No version field: find/ ignores it and returns only title,
            # summary and publisher. A snap's version comes from info/, one
            # request per snap, which is not worth it for a result list --
            # so version is filled in below only for what is installed.
            + "&fields=title,summary,publisher", {},
            # Snapcraft rejects any request without this -- every search was a
            # 400, so Snap has never returned a result. 16 is the only series
            # there has ever been; snapd itself reports it in `snap version`.
            headers={"Snap-Device-Series": "16"},
            tag="Snap Store")
        have = self.installed()
        out = []
        for r in (data.get("results", []) if isinstance(data, dict) else [])[:25]:
            snap = r.get("snap", {})
            n = r.get("name", "")
            out.append(App(
                id=n, name=snap.get("title") or n,
                summary=snap.get("summary") or "",
                developer=(snap.get("publisher") or {}).get("display-name", ""),
                source=self.name, source_id=n,
                installed=n in have, version=have.get(n, ""),
            ))
        return out


# Order matters: merge() gives the primary slot to the first source that
# has an app, and everything after it becomes an alternative. Flatpak
# leads because it is the same build everywhere; the repository package
# is usually smaller and better integrated, so it is offered right after.
SOURCES = [FlatpakSource(), RepoSource(), AurSource(), SnapSource()]


# --------------------------------------------------------------------------
# ratings
# --------------------------------------------------------------------------
def odrs_ratings() -> dict:
    """Star distributions for every app ODRS knows about.

    One request for the lot, cached: this is ~10,700 entries and asking per
    app would make every search a hundred round trips.
    """
    cached = CACHE / "odrs-ratings.json"
    # Every cache operation is best-effort. A cache that cannot be read or
    # written is a slow store, never a broken one -- an unguarded write here
    # took down the entire application with a PermissionError.
    try:
        if cached.exists() and time.time() - os.path.getmtime(cached) < 21600:
            return json.loads(cached.read_text())
    except (OSError, ValueError):
        pass
    data = fetch(f"{ODRS_API}/ratings", {}, tag="ODRS")
    if data:
        try:
            CACHE.mkdir(parents=True, exist_ok=True)
            # Write then rename, so a crash mid-write cannot leave a truncated
            # file that every later run has to fail on and re-fetch.
            tmp = cached.with_suffix(".tmp")
            tmp.write_text(json.dumps(data))
            tmp.replace(cached)
        except OSError as exc:
            FAILURES.setdefault("cache", f"could not cache ratings ({exc})")
    return data or {}


def stars(dist: dict) -> tuple[float | None, int]:
    """Weighted mean of a star distribution, with its sample size.

    The count travels with the average everywhere. A 5.0 from two reviews and
    a 4.3 from nine hundred are different claims, and showing only the number
    hides which one you are looking at.
    """
    total = dist.get("total", 0)
    if not total:
        return None, 0
    score = sum(dist.get(f"star{i}", 0) * i for i in range(6))
    return round(score / total, 1), total


def rating_for(app_id: str, ratings: dict | None = None) -> tuple[float | None, int]:
    """The ODRS rating for one application id.

    ODRS is keyed by desktop-file id, and the same application often appears
    under more than one spelling of it -- Sober has 1160 ratings under
    org.vinegarhq.Sober and a single stray one under
    org.vinegarhq.Sober.desktop. Taking the first key that matched meant
    showing "1 review" for an app with over a thousand, which is exactly how
    it looked next to Discover. The largest pool is the one the application
    actually accumulated, and it is the one Discover shows.
    """
    folded = _odrs_folded()
    best, best_total = None, -1
    # Case matters to nobody but a dictionary lookup: ODRS files Firefox under
    # org.mozilla.Firefox where Flathub calls it org.mozilla.firefox, and the
    # exact-match miss cost the app its 2600 ratings.
    for key in (app_id, f"{app_id}.desktop", f"{app_id}.desktop.desktop"):
        entry = folded.get(key.lower())
        if entry and entry.get("total", 0) > best_total:
            best, best_total = entry, entry["total"]
    return stars(best) if best else (None, 0)


@lru_cache(maxsize=1)
def _odrs_folded() -> dict:
    """Case-folded view of the ratings table, built once per process.

    There are 10,700 entries and a search touches dozens of applications, so
    folding on every lookup would be wasteful.
    """
    out: dict[str, dict] = {}
    for k, v in odrs_ratings().items():
        low = k.lower()
        # Two keys can fold together; keep whichever carries more ratings.
        if v.get("total", 0) > out.get(low, {}).get("total", -1):
            out[low] = v
    return out


def attach_ratings(apps: list[App]) -> None:
    ratings = odrs_ratings()
    for a in apps:
        a.rating, a.rating_count = rating_for(a.id, ratings)


def merge(results: list[list[App]]) -> list[App]:
    """One row per app, with the other sources listed on it.

    Flatpak wins the primary slot where it exists, because that is the source
    that works the same on every machine. The rest are offered on the app's
    own page rather than as duplicate rows in a search.
    """
    order = {s.name: i for i, s in enumerate(SOURCES)}

    def key_for(app: App) -> str:
        # A reverse-DNS id is an identity, and Flathub and
        # archlinux-appstream-data agree on it -- gimp in extra really is
        # org.gimp.GIMP. Match on that where both sides have one; fall back to
        # the display name for the AUR and Snap, which have only bare names.
        if "." in app.id and " " not in app.id:
            return norm_id(app.id)
        return app.name.lower().strip()

    def entry(app: App) -> dict:
        return {"source": app.source, "id": app.source_id,
                "version": app.version, "installed": app.installed}

    by_key: dict[str, App] = {}
    for group in results:
        for app in group:
            key = key_for(app)
            if key not in by_key:
                by_key[key] = app
                continue
            existing = by_key[key]
            if order.get(app.source, 9) < order.get(existing.source, 9):
                app.also_from = existing.also_from + [entry(existing)]
                by_key[key] = app
            else:
                existing.also_from.append(entry(app))
    return list(by_key.values())


def read_config() -> dict:
    out: dict[str, dict] = {}
    try:
        section = ""
        for raw in CONFIG.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
                out.setdefault(section, {})
            elif "=" in line and section:
                k, _, v = line.partition("=")
                out[section][k.strip()] = v.strip()
    except OSError:
        pass
    return out


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------
# The freedesktop menu categories. Flathub serves them at
# /collection/category/<Name> and archlinux-appstream-data tags repository
# packages with exactly the same names, so one vocabulary covers both sources.
# The AUR has no categories at all and Snap uses its own taxonomy; neither is
# invented here, they are simply absent from the category view.
CATEGORIES = [
    ("Graphics", "Graphics & Photography"),
    ("AudioVideo", "Audio & Video"),
    ("Development", "Developer Tools"),
    ("Game", "Games"),
    ("Network", "Internet"),
    ("Office", "Productivity"),
    ("Education", "Education & Science"),
    ("System", "System"),
    ("Utility", "Utilities"),
]


def category(name: str, limit: int = 24) -> list[App]:
    """One category, from every source that has a notion of categories."""
    groups: list[list[App]] = []

    flat = [s for s in SOURCES if s.name == "flatpak"][0]
    if flat.available():
        data = fetch(f"{FLATHUB_API}/collection/category/{urllib.parse.quote(name)}"
                     f"?page=1&per_page={limit}", {}, tag="Flathub")
        groups.append(flat.apps_from_hits(data.get("hits", []), limit))

    repo = RepoSource()
    if repo.available():
        have = repo.installed()
        index = appstream_index()
        hits = []
        for pkg, meta in index.items():
            if meta.get("kind") != "desktop-application":
                continue
            if name not in meta.get("categories", []):
                continue
            hits.append(App(id=meta["id"], name=meta["name"],
                            summary=meta.get("summary", ""),
                            developer=meta.get("developer", ""),
                            icon=meta.get("icon", ""),
                            source="repo", source_id=pkg,
                            installed=pkg in have,
                            version=have.get(pkg, "")))
        hits.sort(key=lambda a: a.name.lower())
        groups.append(hits[:limit])

    apps = merge(groups)
    attach_ratings(apps)
    # Rated things first: within a category, what other people rated is a
    # better opening order than the alphabet.
    apps.sort(key=lambda a: (-(a.rating_count or 0), a.name.lower()))
    return apps[:limit]


def collection(name: str, limit: int = 12) -> list[App]:
    """A real Flathub collection: popular, trending, recently-updated.

    The front page previously ran a search for the word "editor" and labelled
    the result "Popular right now", which was simply untrue. These endpoints
    are what Flathub actually ranks by.
    """
    data = fetch(f"{FLATHUB_API}/collection/{name}?page=1&per_page={limit}",
                 {}, tag="Flathub")
    hits = (data.get("hits") if isinstance(data, dict) else None) or []
    have = FlatpakSource().installed()
    out = []
    for h in hits:
        app_id = h.get("app_id") or h.get("id") or ""
        if not app_id:
            continue
        out.append(App(
            id=app_id, name=h.get("name") or app_id,
            summary=h.get("summary") or "",
            developer=h.get("developer_name") or "",
            icon=h.get("icon") or "",
            source="flatpak", source_id=app_id,
            installed=app_id in have, version=have.get(app_id, ""),
            popularity={"installs": h.get("installs_last_month")}
                        if h.get("installs_last_month") else {},
        ))
    return out


def pacman_version(pkg: str) -> str:
    """The repository version of a package that is not installed."""
    for line in run(["pacman", "-Si", pkg]).splitlines():
        if line.startswith("Version"):
            return line.split(":", 1)[1].strip()
    return ""


def find_elsewhere(app_id: str, name: str) -> list[dict]:
    """The same application from other sources.

    Namespaces do not line up -- Flatpak uses reverse-DNS, the AUR and Snap
    use bare names -- so the last component of the id is tried alongside the
    display name. This is a heuristic and is presented as one: the app page
    offers what it found rather than asserting they are the same build.
    """
    stem = app_id.rsplit(".", 1)[-1].lower()
    words = {stem, name.lower().split()[0]} if name else {stem}
    found = []

    # The repositories are not a guess: AppStream gives their packages the same
    # component id Flathub uses, so this is an exact lookup rather than a
    # search for a similar-looking name.
    repo = RepoSource()
    matched_repo = False
    if repo.available():
        target = norm_id(app_id)
        for pkg, meta in appstream_index().items():
            if norm_id(meta["id"]) != target:
                continue
            have = repo.installed()
            found.append({"source": "repo", "id": pkg,
                          "version": have.get(pkg) or pacman_version(pkg),
                          "installed": pkg in have, "popularity": {},
                          "exact": True})
            matched_repo = True
            break

    for src in SOURCES:
        # Not every repository package has a reverse-DNS id -- Arch files
        # Discord under "discord.desktop", which no normalisation can turn
        # into com.discordapp.Discord -- so when the exact lookup misses, the
        # repositories go through the same name heuristic as everything else.
        if src.name == "flatpak" or (src.name == "repo" and matched_repo):
            continue
        if not src.available():
            continue
        try:
            for hit in src.search(stem):
                if hit.source_id.lower() in words or hit.name.lower() in words:
                    found.append({"source": src.name, "id": hit.source_id,
                                  "version": hit.version,
                                  "installed": hit.installed,
                                  "popularity": hit.popularity,
                                  "exact": False})
                    break
        except Exception:
            continue
    return found


def app_detail(app_id: str) -> dict:
    """Everything the app page needs, in one call.

    Flathub carries the screenshots, the description, the licence and the
    developer's own brand colours. Using the last of those means an app page
    looks like the application rather than like a row in a database.
    """
    d = fetch(f"{FLATHUB_API}/appstream/{app_id}", {}, tag="Flathub") or {}
    if not d:
        return {}

    shots = []
    for sc in (d.get("screenshots") or []):
        sizes = sc.get("sizes") or []
        # Largest available, because these are shown full width and an
        # upscaled 624px thumbnail looks worse than no screenshot at all.
        best = max(sizes, key=lambda x: int(x.get("width") or 0), default=None)
        if best and best.get("src"):
            shots.append({"url": best["src"], "caption": sc.get("caption") or ""})

    brand = ""
    for b in (d.get("branding") or []):
        if b.get("scheme_preference") in ("dark", None) and b.get("value"):
            brand = b["value"]
            if b.get("scheme_preference") == "dark":
                break

    # The same lookup the search results use -- it was duplicated here with the
    # first-match bug, so the app page and the tile could disagree.
    rating, count = rating_for(app_id)

    installed_here = FlatpakSource().installed()

    releases = d.get("releases") or []
    latest = releases[0] if releases else {}

    return {
        "id": app_id,
        "installed": app_id in installed_here,
        # The version installed, and the version on offer. Showing only one of
        # them leaves the user unable to tell whether they are behind.
        "installed_version": installed_here.get(app_id, ""),
        "version": latest.get("version") or "",
        "released": latest.get("timestamp") or 0,
        "source": (d.get("bundle") or {}).get("type") or "flatpak",
        "also_from": find_elsewhere(app_id, d.get("name") or ""),
        "name": d.get("name") or app_id,
        "summary": d.get("summary") or "",
        # Flathub returns HTML; the interface renders it rather than showing
        # tags, so it is passed through unchanged.
        "description": d.get("description") or "",
        "developer": d.get("developer_name") or "",
        "license": d.get("project_license") or "",
        "icon": d.get("icon") or "",
        "brand": brand,
        "screenshots": shots,
        "urls": d.get("urls") or {},
        "rating": rating,
        "rating_count": count,
        "reviews": odrs_reviews(app_id),
    }


def odrs_reviews(app_id: str, limit: int = 8) -> list:
    """Recent reviews for one app.

    Posted and read by GNOME Software and Discover as well, so this is the
    same conversation rather than a private one we started.
    """
    body = {"app_id": f"{app_id}.desktop", "locale": "en_GB",
            "distro": "SakuraOS", "limit": limit,
            "user_hash": "0" * 40, "version": "1.0"}
    data = fetch(f"{ODRS_API}/fetch", [], post=body, tag="ODRS")
    out = []
    for r in (data or [])[:limit]:
        out.append({
            "summary": r.get("summary") or "",
            "text": r.get("description") or "",
            "rating": (r.get("rating") or 0) // 20,   # ODRS stores 0-100
            "author": r.get("user_display") or "Anonymous",
            "date": r.get("date_created") or 0,
            "version": r.get("version") or "",
        })
    return out


def cmd_categories(args) -> int:
    if args.json:
        print(json.dumps([{"id": k, "name": n} for k, n in CATEGORIES], indent=2))
        return 0
    for k, n in CATEGORIES:
        print(f"  {k:<12} {n}")
    return 0


def cmd_category(args) -> int:
    apps = category(args.name, args.limit)
    if args.json:
        print(json.dumps({"apps": [asdict(a) for a in apps],
                          "unavailable": FAILURES}, indent=2))
        return 0
    for a in apps:
        alt = f"  (+{len(a.also_from)})" if a.also_from else ""
        print(f"  {a.source:<8} {a.name}{alt}")
    return 0


def cmd_collection(args) -> int:
    apps = collection(args.name, args.limit)
    attach_ratings(apps)
    if args.json:
        print(json.dumps({"apps": [asdict(a) for a in apps],
                          "unavailable": FAILURES}, indent=2))
        return 0
    for a in apps:
        print(f"  {a.name}" + (f"   {a.rating}★" if a.rating else ""))
    return 0


def cmd_info(args) -> int:
    d = app_detail(args.id)
    if not d:
        print("Not found.")
        return 1
    if args.json:
        print(json.dumps(d, indent=2))
        return 0
    print(f"  {d['name']}  —  {d['developer']}")
    print(f"  {d['summary']}")
    if d["rating"]:
        print(f"  {d['rating']}★ from {d['rating_count']} reviews")
    print(f"  {len(d['screenshots'])} screenshots, {len(d['reviews'])} reviews, "
          f"licence {d['license']}")
    return 0


def cmd_install(args) -> int:
    import transaction as tx
    with tx.transaction_lock():
        if args.source == "flatpak":
            rc = tx.install_flatpak(args.id)
        elif args.source == "repo":
            rc = tx.install_repo(args.id)
        elif args.source == "snap":
            rc = tx.install_snap(args.id)
        elif args.source == "appimage":
            if not args.url:
                tx.emit(tx.FAILED, error="--url is required for an AppImage.")
                return 2
            rc = tx.install_appimage(args.url, args.id, args.sha256 or "")
        elif args.source == "aur":
            rc = tx.install_aur(args.id)
        else:
            tx.emit(tx.FAILED, error=f"Unknown source: {args.source}")
            return 2
    if rc == 0:
        tx.emit(tx.DONE, app=args.id, source=args.source)
    return rc


def cmd_remove_plan(args) -> int:
    """What uninstalling would do, so the confirmation can state it."""
    import transaction as tx
    plan = tx.removal_plan(args.id, args.source)
    if args.json:
        print(json.dumps(plan, indent=2))
        return 0
    if plan["blocked"]:
        print(f"  cannot remove: {plan['reason']}")
        return 2
    for pkg in plan["packages"]:
        print(f"  {pkg}")
    if plan["reason"]:
        print(f"\n  {plan['reason']}")
    return 0


def cmd_remove(args) -> int:
    import transaction as tx
    with tx.transaction_lock():
        if args.source == "flatpak":
            rc = tx.remove_flatpak(args.id, delete_data=args.delete_data)
        elif args.source in ("repo", "aur"):
            # An installed AUR package is an ordinary pacman package; the
            # removal path and its safety check are identical.
            rc = tx.remove_repo(args.id, args.source)
        elif args.source == "snap":
            rc = tx.remove_snap(args.id)
        elif args.source == "appimage":
            import appimage
            path = appimage.APPS / f"{args.id}.AppImage"
            desktop = (appimage.DESKTOP / f"sakura-appimage-{args.id}.desktop")
            path.unlink(missing_ok=True)
            desktop.unlink(missing_ok=True)
            rc = 0
        else:
            tx.emit(tx.FAILED, error=f"Unknown source: {args.source}")
            return 2
    if rc == 0:
        tx.emit(tx.DONE, app=args.id, source=args.source)
    return rc


def cmd_installed(args) -> int:
    import appimage
    rows = []
    index = appstream_index()
    for s in SOURCES:
        if not s.available():
            continue
        names = s.display_names()
        icons = s.local_icons()
        for sid, ver in s.installed_apps().items():
            meta = index.get(sid, {})
            rows.append({"source": s.name, "id": sid, "version": ver,
                         "name": meta.get("name") or names.get(sid) or sid,
                         "summary": meta.get("summary", ""),
                         "icon": meta.get("icon") or icons.get(sid, "")})
    for a in appimage.installed():
        rows.append({"source": "appimage", "id": a["name"],
                     "version": "", "updatable": a["updatable"]})
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for r in rows:
        note = "" if r.get("updatable", True) else "   (cannot self-update)"
        print(f"  {r['source']:<9} {r['id']}{note}")
    return 0


def cmd_sources(args) -> int:
    """Every source, present or not, and why not.

    Sources that are switched off or absent are still listed. Hiding them
    means a person cannot discover that the AUR exists, let alone that it is
    theirs to switch on -- the filter simply vanishes with no explanation.
    """
    def why(src) -> str:
        if src.available():
            return ""
        if src.name == "aur":
            return "Switched off in SakuraOS Settings"
        if src.name == "snap":
            return "snapd is not installed"
        return "Not available on this machine"

    rows = [{"id": s.name, "label": s.label, "available": s.available(),
             "reason": why(s),
             # Searchable but not installable, until the review step exists.
             "installable": s.name != "aur"}
            for s in SOURCES]
    # AppImage has no catalogue to search, so it is not a source in the sense
    # the others are; it appears here only so the UI can say why.
    rows.append({"id": "appimage", "label": "AppImage", "available": False,
                 "reason": "No catalogue to search — AppImages install from a file or a link",
                 "installable": True})
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for r in rows:
        print(f"  {r['id']:<9} {r['label']:<14} "
              f"{'available' if r['available'] else 'unavailable'}")
    return 0


def cmd_search(args) -> int:
    wanted = [s for s in SOURCES
              if (not args.source or s.name == args.source) and s.available()]
    groups = [s.search(args.query) for s in wanted]
    apps = merge(groups)
    attach_ratings(apps)

    apps.sort(key=lambda a: (a.rating_count, a.popularity.get("installs", 0)), reverse=True)

    if args.json:
        print(json.dumps({"apps": [asdict(a) for a in apps],
                          "unavailable": FAILURES}, indent=2))
        return 0

    if not apps:
        print("Nothing found.")
    for tag, why in FAILURES.items():
        print(f"  ({tag} could not be reached: {why})")
    if not apps:
        return 0
    for a in apps[:20]:
        line = f"  {a.name}"
        if a.rating:
            line += f"   {a.rating}★ ({a.rating_count})"
        print(line)
        if a.summary:
            print(f"      {a.summary[:74]}")
        extra = ", ".join(x["source"] for x in a.also_from)
        print(f"      {a.source}" + (f" · also {extra}" if extra else "")
              + (f" · installed" if a.installed else ""))
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="sakura-store", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search")
    s.add_argument("query")
    s.add_argument("--source")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_search)

    v = sub.add_parser("sources")
    v.add_argument("--json", action="store_true")
    v.set_defaults(fn=cmd_sources)

    i = sub.add_parser("install")
    i.add_argument("id")
    i.add_argument("--source", required=True)
    i.add_argument("--url", help="for appimage")
    i.add_argument("--sha256", help="for appimage")
    i.set_defaults(fn=cmd_install)

    rp = sub.add_parser("remove-plan")
    rp.add_argument("id")
    rp.add_argument("--source", required=True)
    rp.add_argument("--json", action="store_true")
    rp.set_defaults(fn=cmd_remove_plan)

    r = sub.add_parser("remove")
    r.add_argument("id")
    r.add_argument("--source", required=True)
    r.add_argument("--delete-data", action="store_true",
                   help="also remove the application's settings and data")
    r.set_defaults(fn=cmd_remove)

    cats = sub.add_parser("categories")
    cats.add_argument("--json", action="store_true")
    cats.set_defaults(fn=cmd_categories)

    cat = sub.add_parser("category")
    cat.add_argument("name", choices=[k for k, _ in CATEGORIES])
    cat.add_argument("--limit", type=int, default=24)
    cat.add_argument("--json", action="store_true")
    cat.set_defaults(fn=cmd_category)

    c = sub.add_parser("collection")
    c.add_argument("name", choices=["popular", "trending",
                                    "recently-updated", "recently-added"])
    c.add_argument("--limit", type=int, default=12)
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_collection)

    n = sub.add_parser("info")
    n.add_argument("id")
    n.add_argument("--json", action="store_true")
    n.set_defaults(fn=cmd_info)

    l = sub.add_parser("installed")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_installed)

    args = p.parse_args()
    try:
        return args.fn(args)
    except Exception as exc:
        # A traceback on stdout is not JSON, so the UI parsed nothing and drew
        # an empty page -- the store looked broken with no indication of why.
        # Anything unhandled is reported in the shape the caller expects, and
        # the detail still goes to stderr for a person reading the log.
        import traceback
        traceback.print_exc()
        # install and remove speak a line-of-JSON progress protocol, so a
        # failure has to arrive in that shape or the caller sees a process
        # that exited with nothing to say.
        if args.cmd in ("install", "remove"):
            print(json.dumps({"stage": "failed",
                              "error": f"{type(exc).__name__}: {exc}",
                              "recoverable": False}), flush=True)
        elif getattr(args, "json", False):
            print(json.dumps({
                "apps": [], "unavailable": dict(
                    FAILURES, engine=f"{type(exc).__name__}: {exc}"),
            }))
        else:
            print(f"  the store failed: {type(exc).__name__}: {exc}",
                  file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
