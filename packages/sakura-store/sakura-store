def cmd_install(args) -> int:
    import transaction as tx
    with tx.transaction_lock():
        if args.source == "flatpak":
            rc = tx.install_flatpak(args.id)
        elif args.source == "repo":
            rc = tx.install_repo(args.id)
        elif args.source == "snap":
            rc = tx.install_snap(args.id)
        elif args.source == "appimage":
            # Either a file the user already has, or a download.
            if args.file:
                rc, derived = tx.install_appimage_file(args.file, args.id)
                # So the DONE event below names what was actually installed.
                args.id = args.id or derived
            elif args.url:
                rc = tx.install_appimage(args.url, args.id, args.sha256 or "")
            else:
                tx.emit(tx.FAILED,
                        error="An AppImage needs either a file or a link.")
                return 2
        elif args.source == "aur":
            # Checked before the review, because the review is not the reason.
            # With the AUR switched off this refused with "has not been
            # reviewed yet", which sends somebody to read a build script when
            # what they actually need is a setting -- and reading it would not
            # have helped, because the next refusal was waiting behind it.
            if not AurSource().available():
                tx.emit(tx.FAILED,
                        error="The AUR is switched off. Turn it on in SakuraOS "
                              "Settings to install this.",
                        recoverable=False)
                return 2
            rc = tx.install_aur(args.id)
        else:
            tx.emit(tx.FAILED, error=f"Unknown source: {args.source}")
            return 2
    if rc == 0:
        tx.emit(tx.DONE, app=args.id, source=args.source)
    return rc


def cmd_remove_plan(args) -> int:
    """What uninstalling would do, so the confirmation can state it."""
    import transaction as tx
    plan = tx.removal_plan(args.id, args.source)
    if args.json:
        print(json.dumps(plan, indent=2))
        return 0
    if plan["blocked"]:
        print(f"  cannot remove: {plan['reason']}")
        return 2
    for pkg in plan["packages"]:
        print(f"  {pkg}")
    if plan["reason"]:
        print(f"\n  {plan['reason']}")
    return 0


def cmd_remove(args) -> int:
    import transaction as tx
    with tx.transaction_lock():
        if args.source == "flatpak":
            rc = tx.remove_flatpak(args.id, delete_data=args.delete_data)
        elif args.source in ("repo", "aur"):
            # An installed AUR package is an ordinary pacman package; the
            # removal path and its safety check are identical.
            rc = tx.remove_repo(args.id, args.source)
        elif args.source == "snap":
            rc = tx.remove_snap(args.id)
        elif args.source == "appimage":
            import appimage
            path = appimage.APPS / f"{args.id}.AppImage"
            desktop = (appimage.DESKTOP / f"sakura-appimage-{args.id}.desktop")
            path.unlink(missing_ok=True)
            desktop.unlink(missing_ok=True)
            rc = 0
        else:
            tx.emit(tx.FAILED, error=f"Unknown source: {args.source}")
            return 2
    if rc == 0:
        tx.emit(tx.DONE, app=args.id, source=args.source)
    return rc


def all_updates() -> list[dict]:
    """Everything installed, from every source, that has a newer version.

    AppImages are included even though they are not a catalogue: each one
    carries its own update information, which is the whole reason the format
    is bearable to live with.
    """
    found: list[dict] = []
    for src in SOURCES:
        if not src.available():
            continue
        try:
            for u in src.updates():
                found.append({**u, "source": src.name})
        except Exception as exc:
            FAILURES[src.label] = f"could not check for updates ({exc})"

    import appimage
    for a in appimage.installed():
        state = a.get("update")
        if state == "available":
            found.append({"source": "appimage", "id": a["name"],
                          "name": a["name"], "current": "", "available": ""})
    return found


def cmd_updates(args) -> int:
    ups = all_updates()
    if args.json:
        print(json.dumps({"updates": ups, "unavailable": FAILURES}, indent=2))
        return 0
    if not ups:
        print("  Everything is up to date.")
        return 0
    for u in ups:
        arrow = f"  {u['current']} -> {u['available']}" if u["available"] else ""
        print(f"  {u['source']:<9} {u['name']}{arrow}")
    return 0


def cmd_update(args) -> int:
    """Apply updates. What can be done without asking for a password is done
    first, so a machine left alone still gets most of the way there."""
    import transaction as tx

    # The setting is read before anything else happens. Checking first and
    # obeying afterwards would mean a machine with automatic updates switched
    # off still going out to Flathub, Snapcraft and every AppImage's update
    # URL every night -- which is most of what the setting is meant to stop.
    if args.unattended:
        if read_config().get("Store", {}).get("AutoUpdate", "true") != "true":
            tx.emit(tx.DONE, detail="automatic updates for applications are off")
            return 0

    ups = all_updates()
    if args.id:
        ups = [u for u in ups if u["id"] == args.id]
    if args.source:
        ups = [u for u in ups if u["source"] == args.source]
    if not ups:
        tx.emit(tx.DONE, detail="everything is up to date")
        return 0

    if args.unattended:
        # Repository packages belong to the update engine, which already
        # takes a snapshot and runs a full -Syu every night. Updating them
        # here as well would do the same work twice and, worse, without that
        # snapshot.
        ups = [u for u in ups if u["source"] != "repo"]

        # What this run can actually reach. Flatpak system installs and snaps
        # need root; AppImages and per-user Flatpaks live in a home directory
        # that root has no business writing to. Splitting it is what lets both
        # halves run unattended without either asking for a password.
        if args.scope == "system":
            ups = [u for u in ups if u["source"] in ("flatpak", "snap")]
        elif args.scope == "user":
            ups = [u for u in ups if u["source"] == "appimage"]
        if not ups:
            tx.emit(tx.DONE, detail="nothing to do in this scope")
            return 0

    failed = 0
    with tx.transaction_lock():
        for u in ups:
            rc = tx.update_one(u["source"], u["id"], unattended=args.unattended)
            if rc != 0:
                failed += 1
    if failed:
        tx.emit(tx.FAILED,
                error=f"{failed} of {len(ups)} could not be updated.",
                recoverable=True)
        return 1
    tx.emit(tx.DONE, detail=f"updated {len(ups)}")
    return 0


# An app list is the names of things, not the things themselves. No settings,
# no data, no home directory -- so it is small, readable, and carries nothing
# private. What it restores is "the same software", which is the part that is
# tedious to redo by hand; what it deliberately does not restore is anything
# that would make it a backup, because a backup that silently misses your data
# is worse than no backup at all.
APP_LIST_VERSION = 1


def cmd_export_list(args) -> int:
    import appimage
    apps = []
    index = appstream_index()
    for s in SOURCES:
        if not s.available():
            continue
        names = s.display_names()
        for sid, _ver in s.installed_apps().items():
            meta = index.get(sid, {})
            apps.append({"id": sid, "source": s.name,
                         "name": meta.get("name") or names.get(sid) or sid})
    for a in appimage.installed():
        # AppImages come from a file or a URL rather than a catalogue, so the
        # id alone cannot find them again. Recorded so the other machine can
        # say what is missing rather than pretend it restored everything.
        apps.append({"id": a["name"], "source": "appimage", "name": a["name"]})

    apps.sort(key=lambda a: (a["source"], a["id"].lower()))
    from datetime import datetime, timezone
    import socket
    doc = {"version": APP_LIST_VERSION,
           "exported": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
           "from": socket.gethostname(),
           "apps": apps}
    text = json.dumps(doc, indent=2) + "\n"
    if args.output and args.output != "-":
        Path(args.output).write_text(text, encoding="utf-8")
        print(json.dumps({"written": args.output, "count": len(apps)}))
    else:
        sys.stdout.write(text)
    return 0


def cmd_read_list(args) -> int:
    """Say what a list would do here, without doing any of it.

    Reading a file must never install anything on its own, so this reports and
    stops. The caller decides, the same way opening an AppImage does.
    """
    try:
        doc = json.loads(Path(args.file).read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        print(json.dumps({"error": f"that file could not be read as an app list: {e}"}))
        return 1
    if not isinstance(doc, dict) or "apps" not in doc:
        print(json.dumps({"error": "that file is not a SakuraOS app list"}))
        return 1
    if doc.get("version", 0) > APP_LIST_VERSION:
        print(json.dumps({"error": "that list was written by a newer version of "
                                   "SakuraOS than this one understands"}))
        return 1

    have = {}
    for s in SOURCES:
        if s.available():
            have[s.name] = set(s.installed_apps().keys())

    rows = []
    for a in doc.get("apps", []):
        sid, src = a.get("id", ""), a.get("source", "")
        if not sid:
            continue
        if src == "appimage":
            state = "manual"          # cannot be fetched from a catalogue
        elif src not in have:
            state = "unavailable"     # that source is switched off here
        elif sid in have[src]:
            state = "present"
        else:
            state = "install"
        rows.append({"id": sid, "source": src,
                     "name": a.get("name") or sid, "state": state})

    print(json.dumps({"from": doc.get("from", ""),
                      "exported": doc.get("exported", ""),
                      "apps": rows,
                      "counts": {k: sum(1 for r in rows if r["state"] == k)
                                 for k in ("install", "present", "unavailable", "manual")}},
                     indent=2))
    return 0


def cmd_installed(args) -> int:
    import appimage
    rows = []
    index = appstream_index()
    for s in SOURCES:
        if not s.available():
            continue
        names = s.display_names()
        icons = s.local_icons()
        for sid, ver in s.installed_apps().items():
            meta = index.get(sid, {})
            rows.append({"source": s.name, "id": sid, "version": ver,
                         "name": meta.get("name") or names.get(sid) or sid,
                         "summary": meta.get("summary", ""),
                         "icon": meta.get("icon") or icons.get(sid, "")})
    for a in appimage.installed():
        rows.append({"source": "appimage", "id": a["name"],
                     "version": "", "updatable": a["updatable"]})
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for r in rows:
        note = "" if r.get("updatable", True) else "   (cannot self-update)"
        print(f"  {r['source']:<9} {r['id']}{note}")
    return 0


def cmd_sources(args) -> int:
    """Every source, present or not, and why not.

    Sources that are switched off or absent are still listed. Hiding them
    means a person cannot discover that the AUR exists, let alone that it is
    theirs to switch on -- the filter simply vanishes with no explanation.
    """
    def why(src) -> str:
        if src.available():
            return ""
        if src.name == "aur":
            return "Switched off in SakuraOS Settings"
        if src.name == "snap":
            return "snapd is not installed"
        return "Not available on this machine"

    rows = [{"id": s.name, "label": s.label, "available": s.available(),
             "reason": why(s),
             # Searchable but not installable, until the review step exists.
             "installable": s.name != "aur"}
            for s in SOURCES]
    # AppImage has no catalogue to search, so it is not a source in the sense
    # the others are; it appears here only so the UI can say why.
    rows.append({"id": "appimage", "label": "AppImage", "available": False,
                 "reason": "No catalogue to search. AppImages install from a file or a link",
                 "installable": True})
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for r in rows:
        print(f"  {r['id']:<9} {r['label']:<14} "
              f"{'available' if r['available'] else 'unavailable'}")
    return 0


def cmd_search(args) -> int:
    # --source takes one name or a comma-separated set, so the store can
    # search the subset the user has left switched on.
    picked = [x for x in (args.source or "").split(",") if x]
    wanted = [s for s in SOURCES
              if (not picked or s.name in picked) and s.available()]
    groups = [s.search(args.query) for s in wanted]
    apps = merge(groups)
    attach_ratings(apps)

    # How well it matches what was typed comes before how popular it is.
    # Sorting on ratings alone put Flathub's "Calculator" above "KCalc" for
    # the query "kcalc": a more popular app that merely mentions the word beat
    # the one actually named it. Somebody typing an exact name has told you
    # precisely what they want, and no rating count outranks that.
    q = args.query.strip().lower()

    def rank(a):
        name = (a.name or "").lower()
        ident = (a.source_id or a.id or "").lower()
        if name == q or ident == q:
            tier = 0                        # exactly what was asked for
        elif name.startswith(q) or ident.startswith(q):
            tier = 1                        # the name begins with it
        elif q in name or q in ident:
            tier = 2                        # the name contains it
        else:
            tier = 3                        # matched on description alone
        return (tier,
                -(a.rating_count or 0),
                -(a.popularity.get("installs", 0) or 0),
                name)

    apps.sort(key=rank)

    if args.json:
        print(json.dumps({"apps": [asdict(a) for a in apps],
                          "unavailable": FAILURES}, indent=2))
        return 0

    if not apps:
        print("Nothing found.")
    for tag, why in FAILURES.items():
        print(f"  ({tag} could not be reached: {why})")
    if not apps:
        return 0
    for a in apps[:20]:
        line = f"  {a.name}"
        if a.rating:
            line += f"   {a.rating}★ ({a.rating_count})"
        print(line)
        if a.summary:
            print(f"      {a.summary[:74]}")
        extra = ", ".join(x["source"] for x in a.also_from)
        print(f"      {a.source}" + (f" · also {extra}" if extra else "")
              + (f" · installed" if a.installed else ""))
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="sakura-store", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search")
    s.add_argument("query")
    s.add_argument("--source")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_search)

    v = sub.add_parser("sources")
    v.add_argument("--json", action="store_true")
    v.set_defaults(fn=cmd_sources)

    rv = sub.add_parser("review", help="publish a review to ODRS")
    rv.add_argument("app_id")
    rv.add_argument("--rating", type=int, required=True, help="1 to 5")
    rv.add_argument("--summary", required=True)
    rv.add_argument("--description", required=True)
    rv.add_argument("--name", default="", help="shown publicly beside the review")
    rv.add_argument("--version", default="", help="version reviewed")
    rv.add_argument("--json", action="store_true")
    rv.set_defaults(fn=cmd_review)

    i = sub.add_parser("install")
    # Optional for a local AppImage, which is named after the file.
    i.add_argument("id", nargs="?", default="")
    i.add_argument("--source", required=True)
    i.add_argument("--url", help="for appimage: download it from here")
    i.add_argument("--file", help="for appimage: install this local file")
    i.add_argument("--sha256", help="for appimage")
    i.set_defaults(fn=cmd_install)

    rp = sub.add_parser("remove-plan")
    rp.add_argument("id")
    rp.add_argument("--source", required=True)
    rp.add_argument("--json", action="store_true")
    rp.set_defaults(fn=cmd_remove_plan)

    r = sub.add_parser("remove")
    r.add_argument("id")
    r.add_argument("--source", required=True)
    r.add_argument("--delete-data", action="store_true",
                   help="also remove the application's settings and data")
    r.set_defaults(fn=cmd_remove)

    cats = sub.add_parser("categories")
    cats.add_argument("--json", action="store_true")
    cats.set_defaults(fn=cmd_categories)

    cat = sub.add_parser("category")
    cat.add_argument("name", choices=[k for k, _ in CATEGORIES])
    cat.add_argument("--limit", type=int, default=24)
    cat.add_argument("--json", action="store_true")
    cat.set_defaults(fn=cmd_category)

    c = sub.add_parser("collection")
    c.add_argument("name", choices=["popular", "trending",
                                    "recently-updated", "recently-added"])
    c.add_argument("--limit", type=int, default=12)
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_collection)

    n = sub.add_parser("info")
    n.add_argument("id")
    n.add_argument("--json", action="store_true")
    n.set_defaults(fn=cmd_info)

    up = sub.add_parser("updates", help="what has a newer version")
    up.add_argument("--json", action="store_true")
    up.set_defaults(fn=cmd_updates)

    ap = sub.add_parser("update", help="install newer versions")
    ap.add_argument("--id", help="just this one")
    ap.add_argument("--source", help="just this source")
    # Passed by the timer, never by a person: it is what makes the settings
    # apply, and what keeps anything needing a password out of the way.
    ap.add_argument("--unattended", action="store_true")
    ap.add_argument("--scope", choices=["system", "user"],
                    help="which half of an unattended run this is")
    ap.set_defaults(fn=cmd_update)

    ar = sub.add_parser("aur-review", help="show an AUR build script")
    ar.add_argument("name")
    ar.set_defaults(fn=cmd_aur_review)

    aa = sub.add_parser("aur-accept", help="record that a build script was read")
    aa.add_argument("name")
    aa.set_defaults(fn=cmd_aur_accept)

    ex = sub.add_parser("export-list", help="write the installed app list")
    ex.add_argument("--output", default="-")
    ex.set_defaults(fn=cmd_export_list)

    rd = sub.add_parser("read-list", help="say what an app list would install")
    rd.add_argument("file")
    rd.set_defaults(fn=cmd_read_list)

    l = sub.add_parser("installed")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_installed)

    args = p.parse_args()
    try:
        return args.fn(args)
    except Exception as exc:
        # A traceback on stdout is not JSON, so the UI parsed nothing and drew
        # an empty page -- the store looked broken with no indication of why.
        # Anything unhandled is reported in the shape the caller expects, and
        # the detail still goes to stderr for a person reading the log.
        import traceback
        traceback.print_exc()
        # install and remove speak a line-of-JSON progress protocol, so a
        # failure has to arrive in that shape or the caller sees a process
        # that exited with nothing to say.
        if args.cmd in ("install", "remove"):
            print(json.dumps({"stage": "failed",
                              "error": f"{type(exc).__name__}: {exc}",
                              "recoverable": False}), flush=True)
        elif getattr(args, "json", False):
            print(json.dumps({
                "apps": [], "unavailable": dict(
                    FAILURES, engine=f"{type(exc).__name__}: {exc}"),
            }))
        else:
            print(f"  the store failed: {type(exc).__name__}: {exc}",
                  file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
