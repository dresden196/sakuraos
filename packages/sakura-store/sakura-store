def cmd_install(args) -> int:
    import transaction as tx
    with tx.transaction_lock():
        if args.source == "flatpak":
            rc = tx.install_flatpak(args.id)
        elif args.source == "repo":
            rc = tx.install_repo(args.id)
        elif args.source == "snap":
            rc = tx.install_snap(args.id)
        elif args.source == "appimage":
            # Either a file the user already has, or a download.
            if args.file:
                rc, derived = tx.install_appimage_file(args.file, args.id)
                # So the DONE event below names what was actually installed.
                args.id = args.id or derived
            elif args.url:
                rc = tx.install_appimage(args.url, args.id, args.sha256 or "")
            else:
                tx.emit(tx.FAILED,
                        error="An AppImage needs either a file or a link.")
                return 2
        elif args.source == "aur":
            rc = tx.install_aur(args.id)
        else:
            tx.emit(tx.FAILED, error=f"Unknown source: {args.source}")
            return 2
    if rc == 0:
        tx.emit(tx.DONE, app=args.id, source=args.source)
    return rc


def cmd_remove_plan(args) -> int:
