# Maintainer: dresden196 <dresden196@users.noreply.github.com>
#
# The store engine. Sources are an interface, so adding one -- including a
# Sakura-hosted source later -- means implementing search, installed and
# available rather than editing the window.
pkgname=sakura-store
pkgver=0.1.0
pkgrel=1
pkgdesc="SakuraOS app store engine"
arch=('any')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
# archlinux-appstream-data is what gives repository packages an icon, a
# display name and -- the part that matters -- the same AppStream id Flathub
# uses, which is how one app is recognised across two sources.
depends=('python' 'flatpak' 'sakura-settings-core' 'archlinux-appstream-data' 'pacman'
         # pactree, which computes what a removal would cascade into.
         # Without it the store cannot tell a safe uninstall from one
         # that would take the desktop with it.
         'pacman-contrib'
         # checkupdates, which is how repository updates are found without a
         # -Sy against the real database, refuses to run without fakeroot.
         # Missing, it fails with an error the store then reported as
         # "everything is up to date".
         'fakeroot')
optdepends=('zsync2: AppImage delta updates'
            'snapd: Snap support'
            'binutils: reading AppImage update information')
source=('sakura-store' 'appimage.py' 'transaction.py'
        'sakura-store.tmpfiles'
        'sakura-store-updates.service'
        'sakura-store-updates.timer'
        'sakura-store-updates-user.service'
        'sakura-store-updates-user.timer')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/sakura-store" "$pkgdir/usr/bin/sakura-store"
    install -Dm644 "$srcdir/appimage.py" \
        "$pkgdir/usr/lib/sakura/store/appimage.py"
    install -Dm644 "$srcdir/transaction.py" \
        "$pkgdir/usr/lib/sakura/store/transaction.py"
    # The lock is created at boot under /run by tmpfiles, not shipped in
    # /var/lib -- see sakura-store.tmpfiles for why.
    # Two timers because the work splits in two: what needs root, and what
    # lives in a home directory. See the units for why.
    install -Dm644 "$srcdir/sakura-store-updates.service" \
        "$pkgdir/usr/lib/systemd/system/sakura-store-updates.service"
    install -Dm644 "$srcdir/sakura-store-updates.timer" \
        "$pkgdir/usr/lib/systemd/system/sakura-store-updates.timer"
    install -Dm644 "$srcdir/sakura-store-updates-user.service" \
        "$pkgdir/usr/lib/systemd/user/sakura-store-updates.service"
    install -Dm644 "$srcdir/sakura-store-updates-user.timer" \
        "$pkgdir/usr/lib/systemd/user/sakura-store-updates.timer"
    install -Dm644 "$srcdir/sakura-store.tmpfiles" \
        "$pkgdir/usr/lib/tmpfiles.d/sakura-store.conf"
}
