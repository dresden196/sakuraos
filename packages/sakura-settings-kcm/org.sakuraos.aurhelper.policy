<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SakuraOS</vendor>
  <vendor_url>https://sakuraos.org</vendor_url>

  <!--
    Installing and removing the command-line AUR helper. The helper takes one
    verb from a fixed set and one name from a list of two; there is nothing
    here that can be pointed at a package the caller chose, which matters
    because this runs as root.

    auth_admin_keep rather than auth_admin, for the same reason as Wine: this
    is reached from a dropdown, and somebody who picks yay, changes their mind
    and picks paru should not be asked to authenticate twice in a minute.
  -->
  <action id="org.sakuraos.aurhelper.manage">
    <description>Install or remove the command-line AUR helper</description>
    <message>Authentication is required to change the AUR helper</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/sakura/settings/sakura-aur-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
