# Arch leaves an unowned /etc/os-release symlink pointing at /usr/lib. pacman
# refuses to overwrite unowned files, so it has to go before our real file
# lands. Only remove it if it is still a symlink — never touch a real file
# somebody may have edited.
pre_install() {
    if [ -L etc/os-release ]; then
        rm -f etc/os-release
    fi
}

_activate_repos() {
    # Do it, rather than print instructions telling the user to do it. A
    # config file nothing includes is inert, and the previous version shipped
    # a working repository definition that pacman never read.
    grep -q 'sakura-core.conf' etc/pacman.conf 2>/dev/null && return 0
    sed -i '/^\[core\]/i Include = /etc/pacman.d/sakura-core.conf\n' etc/pacman.conf
}

post_install() {
    pre_install
    _activate_repos
}

post_upgrade() {
    _activate_repos
}

pre_remove() {
    sed -i '\|^Include = /etc/pacman.d/sakura-core.conf$|d' etc/pacman.conf 2>/dev/null || true
}
