# Maintainer: dresden196 <dresden196@users.noreply.github.com>
#
# The settings file every other component reads. Kept in its own package so
# that policy and the things enforcing it can be installed independently, and
# so the System Settings module has exactly one file to bind to.
pkgname=sakura-settings-core
pkgver=0.1.0
pkgrel=1
pkgdesc="SakuraOS system settings schema"
arch=('any')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
backup=('etc/sakura/sakura.conf' 'etc/systemd/zram-generator.conf')
source=('sakura.conf' 'zram-generator.conf' '99-sakura-zram.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm644 "$srcdir/sakura.conf" "$pkgdir/etc/sakura/sakura.conf"
    install -Dm644 "$srcdir/zram-generator.conf" "$pkgdir/etc/systemd/zram-generator.conf"
    install -Dm644 "$srcdir/99-sakura-zram.conf" "$pkgdir/etc/sysctl.d/99-sakura-zram.conf"
}
