# Maintainer: SakuraOS <dev@sakuraos.invalid>
#
# This meta package defines the INSTALLED system. It is deliberately separate
# from iso/packages.x86_64, which defines the LIVE MEDIA. Conflating the two is
# how a distro ends up shipping its installer's dependencies onto every user's
# machine.
pkgname=sakura-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="SakuraOS desktop system"
arch=('any')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
groups=('sakura')
depends=(
    # Identity and trust
    'sakura-branding'
    'sakura-keyring'

    # Desktop tuning defaults -- memory management and I/O scheduling, the
    # part of the CachyOS kernel's tuning that is reachable at runtime and
    # therefore does not need a kernel of our own. See docs/kernel.md.
    'sakura-tuning'

    # Boot splash. 'splash' was already on the kernel command line and did
    # nothing, because nothing was there to draw it.
    'sakura-plymouth'

    # Known-campaign scanning for the AUR. Present even on a machine with the
    # AUR switched off: the lists are about packages already on disk, and a
    # machine that had the AUR on last month is exactly the one worth checking.
    'sakura-aur-campaign-check'

    # Base system. No kernel named here on purpose: which one a machine can
    # run depends on the machine, so the installer decides between the tuned
    # x86-64-v3 kernel and the stock one and installs that. Arch's own base
    # names no kernel either, for the same reason.
    'base'
    'linux-firmware'
    'sudo'
    # systemd fsck's the ESP on every boot because genfstab gives it passno 2.
    # Without fsck.fat that unit fails, local-fs.target fails, and the machine
    # drops to emergency mode -- where root is locked, so there is no way in.
    'dosfstools'

    # Compressed swap in RAM. Without any swap the kernel has nowhere to put
    # cold pages and responds to memory pressure by killing something.
    'zram-generator'

    # Boot chain: limine + UKI, with recovery rollback and Secure Boot signing
    'limine'
    'sakura-snapshot-boot'
    'sbctl'
    'efibootmgr'
    'mkinitcpio'

    # Filesystem and the rollback story
    'btrfs-progs'
    # Full-disk encryption. Needed in the initramfs to unlock the disk at
    # boot, and on the installed system to add or remove a passphrase -- and
    # to turn encryption off again, which LUKS2 can do in place.
    'cryptsetup'
    'snapper'
    'snap-pac'

    # Plasma
    'plasma-desktop'
    'kwin'
    'sddm'
    'qt6-wayland'
    'xorg-xwayland'
    'xdg-desktop-portal-kde'
    'plasma-nm'
    'plasma-pa'
    'kscreen'
    'bluedevil'
    # The Settings page for the login screen; without it there is no way to
    # change the greeter from the GUI.
    'sddm-kcm'
    'sakura-theme'
    'sakura-wallpapers'

    # Services
    'networkmanager'
    'power-profiles-daemon'

    # Audio
    'pipewire'
    'pipewire-alsa'
    'pipewire-pulse'
    'wireplumber'

    # Audio effects: an equaliser, and the noise suppression people actually
    # want on a laptop microphone. Its own application rather than something
    # buried in settings, because it is a thing you open, fiddle with and
    # close.
    'easyeffects'

    # KWallet asking for a password every time an application starts is one
    # of the loudest complaints about a KDE desktop, and the advice people
    # find is to switch it off -- which puts wifi, Samba and browser
    # passwords back in plain text and breaks anything that expects a Secret
    # Service. kwallet-pam is the actual fix: the wallet is unlocked by the
    # password already typed at login, so it never asks again. See
    # sakura-install for the PAM lines that make it work; the package alone
    # does nothing.
    'kwallet-pam'
    # The window for looking at what is stored and forgetting one of them.
    # Without it a wallet can be filled but never inspected.
    'kwalletmanager'

    # Bluetooth. bluedevil above is only the Plasma front end -- without the
    # daemon it has nothing to talk to, so Bluetooth did not work at all.
    'bluez'
    'bluez-utils'

    # Printing and scanning. There was none of this, so a printer could not be
    # added by any route. print-manager is the Plasma page; cups-pdf gives a
    # "print to PDF" target on a machine with no printer at all; the driver
    # databases are what make a printer work without hunting for a PPD.
    'cups'
    'cups-pdf'
    'cups-filters'
    'print-manager'
    'gutenprint'
    'foomatic-db'
    'foomatic-db-ppds'
    'sane'
    'skanpage'

    # Applications
    'konsole'
    'dolphin'
    # kate ships kwrite too, so both editors come from this one package.
    'kate'
    'ark'
    'kcalc'
    'okular'
    'gwenview'
    'spectacle'
    'filelight'
    'kolourpaint'
    'plasma-systemmonitor'
    'kdeconnect'
    'kamoso'
    'merkuro'
    'kdenlive'
    # Video: Haruna is a KDE front end over libmpv, so it is mpv's playback
    # with a Plasma-native interface. Recorded as a decision in
    # docs/defaults.md, where the mpv-versus-VLC question is still open.
    'haruna'

    # Fonts, otherwise the session renders as tofu. The CJK set is not
    # optional here: without it Chinese, Japanese and Korean text renders as
    # empty boxes, which on an operating system named after a Japanese word
    # is a poor look and a broken machine for anyone reading those scripts.
    'noto-fonts'
    'noto-fonts-emoji'
    'noto-fonts-cjk'
    # noto-fonts-extra is deliberately not here. It is 331 MiB of additional
    # weights and widths -- "additional variants" is upstream's own
    # description -- on top of the 107 MiB base set, and it buys typography
    # rather than coverage. On media that ships offline that is a third of a
    # gigabyte for styles almost nobody will look at. CJK is the opposite: it
    # is 299 MiB that decides whether text renders at all.

    # Codecs. GStreamer's good and bad sets arrive as dependencies; ugly and
    # libav do not, and without them Haruna fails on H.264, H.265 and MP3 --
    # which is to say on most of what anybody actually has. ffmpegthumbs is
    # what puts thumbnails on videos in Dolphin.
    'gst-plugins-ugly'
    'gst-libav'
    'ffmpegthumbs'

    # A terminal with no editor in it is a trap: visudo, crontab -e and
    # anything reading $EDITOR all land on nothing. nano rather than vim
    # because somebody who did not choose to be in a text editor can leave
    # nano without being told how.
    'nano'

    # Named rather than left to arrive as somebody else's dependency. curl and
    # git in particular are load-bearing -- the store fetches with one and
    # clones from the AUR with the other -- and a dependency that arrives by
    # accident can leave by accident too. unzip is what Ark shells out to for
    # the most common archive format there is.
    'curl'
    'wget'
    'git'
    'unzip'

    # The store itself. It was missing from this list entirely, so a freshly
    # installed machine had no way to install software -- the one thing the
    # project is built around. sakura-install and sakura-installer stay out on
    # purpose: they belong to the live media, and an installed system should
    # not carry a disk-erasing wizard.
    'sakura-store'
    'sakura-store-ui'
    # Windows applications. Wine itself is not installed until somebody asks
    # for it; this is the switch, the guard, and the database behind it.
    'sakura-wine'
    # The store needs Flatpak present; AppStream metadata drives its listings
    'flatpak'
    'archlinux-appstream-data'
    # Snap. We rebuild snapd into sakura-core precisely so it works here
    # without anyone reaching for the AUR -- and then never installed it, so
    # the store correctly reported "snapd is not installed" on every machine.
    # docs/store.md calls supporting Snap a standing commitment; this is what
    # that costs.
    'snapd'

    # Updates
    'pacman-contrib'
    'sakura-updates'
    'sakura-update-center'

    # Policy, and the layer that enforces it
    'sakura-settings-core'
    'sakura-terminal-assist'
    'sakura-settings-kcm'
)

package() {
    install -d "$pkgdir/usr/share/sakura"
    echo "$pkgver" > "$pkgdir/usr/share/sakura/desktop-version"
}
