# Maintainer: SakuraOS <dev@sakuraos.invalid>
#
# One implementation of the update logic, three front ends: the Update Centre
# draws it, the timer runs it unattended, and a terminal can drive it
# directly. Three implementations would eventually disagree about what is
# held and why.
pkgname=sakura-updates
pkgver=0.1.0
pkgrel=1
pkgdesc="SakuraOS update engine"
arch=('any')
url="https://sakuraos.org"
license=('GPL-3.0-or-later')
depends=('python' 'pacman-contrib' 'snapper' 'sakura-settings-core' 'polkit')
source=('sakura-update' 'sakura-update-helper' 'org.sakuraos.updates.policy'
        'sakura-updates.service' 'sakura-updates.timer'
        'sakura-updates-schedule')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/sakura-update" "$pkgdir/usr/bin/sakura-update"
    install -Dm755 "$srcdir/sakura-update-helper" \
        "$pkgdir/usr/lib/sakura/updates/sakura-update-helper"
    install -Dm644 "$srcdir/org.sakuraos.updates.policy" \
        "$pkgdir/usr/share/polkit-1/actions/org.sakuraos.updates.policy"
    install -Dm644 "$srcdir/sakura-updates.service" \
        "$pkgdir/usr/lib/systemd/system/sakura-updates.service"
    install -Dm644 "$srcdir/sakura-updates.timer" \
        "$pkgdir/usr/lib/systemd/system/sakura-updates.timer"
    install -Dm755 "$srcdir/sakura-updates-schedule" \
        "$pkgdir/usr/lib/sakura/updates/sakura-updates-schedule"
    install -d "$pkgdir/var/lib/sakura/updates"
}
