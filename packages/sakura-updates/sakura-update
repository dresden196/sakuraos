#!/usr/bin/env python3
"""SakuraOS update engine.

Does the work; the Update Centre draws it. Kept as a separate command so the
same logic serves the GUI, the nightly timer, and anyone who prefers a
terminal -- three front ends over one implementation rather than three
implementations that disagree.

  sakura-update check    what is available, classified, in plain language
  sakura-update apply    snapshot, then install what is not held
  sakura-update status   one line: current, or not
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import subprocess
import sys
import urllib.request
from datetime import datetime, timedelta, timezone
from dataclasses import dataclass, asdict, field
from pathlib import Path

CONFIG = Path(os.environ.get("SAKURA_CONFIG", "/etc/sakura/sakura.conf"))
STATE = Path(os.environ.get("SAKURA_STATE", "/var/lib/sakura/updates"))
NEWS_URL = "https://archlinux.org/feeds/news/"
ADVISORY_URL = "https://repo.sakuraos.org/advisories.json"
# Long enough that a real hold survives a weekend, short enough that a dead
# canary cannot freeze anybody's machine indefinitely.
ADVISORY_MAX_AGE_DAYS = 7

# A package whose upgrade means the running system no longer matches what is
# on disk. Nothing here can take effect until a restart, so saying so is the
# difference between a system that is updated and one that only looks it.
NEEDS_RESTART = {"systemd", "glibc", "dbus", "dbus-broker", "mesa"}


def needs_restart(name: str) -> bool:
    """Whether upgrading this package leaves the running system behind.

    Kernels are recognised by what they contain rather than what they are
    called. This was a list of names -- linux, linux-lts, linux-zen,
    linux-hardened -- and SakuraOS installs linux-cachyos on any CPU with
    x86-64-v3 and the stock linux kernel on anything older. So the machines
    that got the tuned kernel were exactly the machines never told to restart
    after a kernel update, and which half of the fleet was warned depended on
    its processor.

    A kernel owns a vmlinuz. Headers, firmware and documentation do not, which
    is the distinction that matters and the one a list of names kept missing.

    The same applies to the graphics driver: the set named nvidia-open and
    nvidia-utils, while what SakuraOS actually ships is nvidia-580xx-utils.
    """
    if name in NEEDS_RESTART or name.startswith("nvidia"):
        return True
    if not name.startswith("linux") or name.endswith(("-headers", "-docs")):
        return False
    if name.startswith("linux-firmware"):
        return False
    files = run(["pacman", "-Qlq", name])
    if not files:
        # Nothing came back: the package is not installed, or the query
        # failed. Content cannot answer, and the safe direction for this
        # particular question is yes. An unnecessary restart prompt is an
        # annoyance; a missing one leaves somebody running last week's kernel
        # believing they are up to date, which is the whole failure this
        # function exists to prevent.
        return True
    return "/vmlinuz" in files

# Arch announces breaking changes in prose, not in package metadata. These are
# the phrases that have historically meant "do something by hand first".
INTERVENTION = re.compile(
    r"manual intervention|requires? action|before upgrading|"
    r"you (?:must|need to)|manually|breaking change",
    re.I,
)


def run(args: list[str], **kw) -> str:
    return subprocess.run(args, capture_output=True, text=True, **kw).stdout


@dataclass
class Update:
    name: str
    old: str
    new: str
    summary: str = ""
    needed_by: list[str] = field(default_factory=list)
    restart: bool = False
    held: str = ""          # reason, empty when not held


def read_config() -> dict:
    """Parse the [Updates] section. Hand-rolled and tolerant: this runs from a
    timer with no one watching, and an unparseable file must not stop updates
    forever."""
    out = {"AutoApply": "true", "RequireCanaryEvidence": "true",
           "Window": "03:00", "RequireACPower": "true", "AutoReboot": "false"}
    try:
        section = ""
        for raw in CONFIG.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
            elif section == "Updates" and "=" in line:
                k, _, v = line.partition("=")
                out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def available() -> list[Update]:
    """Pending upgrades.

    checkupdates (pacman-contrib) syncs into a throwaway database rather than
    the system one. That matters: a plain 'pacman -Sy' to see what is
    available is itself the partial-upgrade footgun Terminal Assist exists to
    stop.
    """
    out = run(["checkupdates"])
    ups = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[2] == "->":
            ups.append(Update(name=parts[0], old=parts[1], new=parts[3]))
    return ups


def describe(ups: list[Update]) -> None:
    """Turn version numbers into something a person can consent to.

    'libjxl 0.12.0-1' tells you nothing. 'JPEG XL image support, needed by
    Dolphin, Gwenview, Firefox' tells you whether you care.
    """
    for u in ups:
        info = run(["pacman", "-Si", u.name])
        for line in info.splitlines():
            if line.startswith("Description"):
                u.summary = line.split(":", 1)[1].strip()
                break

        # Reverse dependencies, filtered to things the user has heard of --
        # the full tree is mostly libraries depending on libraries.
        tree = run(["pactree", "-r", "-d1", "-u", u.name]).splitlines()[1:]
        named = [t.strip() for t in tree if t.strip() and t.strip() != u.name]
        u.needed_by = [n for n in named if not n.startswith("lib")][:4] or named[:3]
        u.restart = needs_restart(u.name)


def news_items() -> list[str]:
    """Arch news headlines that read like they need a human first."""
    try:
        with urllib.request.urlopen(NEWS_URL, timeout=15) as r:
            feed = r.read().decode("utf-8", "replace")
    except Exception:
        # No feed is not the same as no interventions, but refusing to update
        # because a web request failed would strand a machine offline.
        return []

    items = []
    for item in re.findall(r"<item>(.*?)</item>", feed, re.S)[:25]:
        title = re.search(r"<title>(.*?)</title>", item, re.S)
        if not title or not INTERVENTION.search(re.sub(r"<[^>]+>", " ", item)):
            continue
        t = re.sub(r"<[^>]+>", "", title.group(1))
        items.append(re.sub(r"&[a-z]+;", " ", t).strip())
    return items


def _mentions(title: str, pkg: str) -> bool:
    """Does this headline appear to be about this package?

    Headlines name their package plainly -- "kea >= 1:3.0.3-6 requires manual
    intervention", "Breaking changes for all users of `varnish`". Matching on
    the name is what keeps the gate useful: Arch's intervention notices never
    expire from the feed, so holding the whole transaction whenever any of
    them is present would hold every update forever.
    """
    words = set(re.findall(r"[a-z0-9][a-z0-9._+-]*", title.lower()))
    if pkg.lower() in words:
        return True
    # linux-firmware-nvidia should match a notice about nvidia; the reverse
    # (a notice about "linux" matching every linux-* package) is why only the
    # leading component is tried.
    stem = pkg.lower().split("-")[0]
    return len(stem) > 3 and stem in words


def canary_broken() -> tuple[list[str], str]:
    """Packages a canary machine could not survive.

    A machine of ours installs every pending update, reboots and re-runs the
    install checks. When that fails, everything in the transaction is listed
    here: the canary knows the update broke a machine, not which package did
    it, and pretending to more precision than that would hold back the wrong
    things.

    Fails open, deliberately and in the same direction as the news feed. A
    machine that cannot reach us must still get its security updates; holding
    everything back because a web request failed would strand exactly the
    machines least able to recover.
    """
    try:
        with urllib.request.urlopen(ADVISORY_URL, timeout=15) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
    except Exception:
        return [], ""
    if not isinstance(data, dict):
        return [], ""

    # An advisory that stopped being refreshed must stop being obeyed.
    # Otherwise one failed canary run followed by the canary itself dying
    # holds those packages on every machine forever, and nobody finds out --
    # which is the silent freeze this whole design exists to avoid, with the
    # added insult that no human decided it.
    stamp = str(data.get("generated", ""))
    try:
        age = datetime.now(timezone.utc) - datetime.fromisoformat(
            stamp.replace("Z", "+00:00"))
    except ValueError:
        return [], ""
    if age > timedelta(days=ADVISORY_MAX_AGE_DAYS):
        return [], ""

    broken = [p for p in data.get("broken", []) if isinstance(p, str)]
    return broken, str(data.get("reason", ""))


def apply_holds(ups: list[Update], cfg: dict) -> list[tuple[str, str]]:
    """Hold only the packages a notice is actually about."""
    holds = []

    # Evidence from our own machines, when the setting asks for it.
    if cfg.get("RequireCanaryEvidence", "true").lower() == "true":
        broken, reason = canary_broken()
        if broken:
            matched = [u for u in ups if u.name in broken]
            for u in matched:
                u.held = "This update broke a test machine of ours."
            if matched:
                holds.append((reason or "Held after a failed test install",
                              ", ".join(u.name for u in matched)))

    for title in news_items():
        matched = [u for u in ups if _mentions(title, u.name)]
        if not matched:
            continue
        for u in matched:
            u.held = "Arch published a manual step for this update."
        holds.append((title, ", ".join(u.name for u in matched)))
    return holds


def snapshot(desc: str) -> bool:
    r = subprocess.run(
        ["snapper", "--no-dbus", "-c", "root", "create",
         "--description", desc, "--cleanup-algorithm", "number"],
        capture_output=True, text=True)
    return r.returncode == 0


def cmd_check(args) -> int:
    cfg = read_config()
    ups = available()
    if ups:
        describe(ups)
    holds = apply_holds(ups, cfg)

    if args.json:
        print(json.dumps({
            "updates": [asdict(u) for u in ups],
            "holds": [{"title": t, "reason": r} for t, r in holds],
            "restart_required": any(u.restart for u in ups),
        }, indent=2))
        return 0

    if not ups:
        print("Everything is up to date.")
        return 0

    held = [u for u in ups if u.held]
    ready = [u for u in ups if not u.held]

    if ready:
        print(f"\n{len(ready)} update{'s' if len(ready) != 1 else ''} ready\n")
        for u in ready:
            print(f"  {u.name}  {u.old} → {u.new}")
            if u.summary:
                print(f"      {u.summary}")
            if u.needed_by:
                print(f"      Needed by: {', '.join(u.needed_by)}")
            if u.restart:
                print("      Needs a restart to take effect")
        print()
    if held:
        print(f"{len(held)} held back, waiting for you\n")
        for title, pkgs in holds:
            print(f"  {pkgs}")
            print(f"      Arch published a manual step: {title}\n")
    return 0


HELPER = "/usr/lib/sakura/updates/sakura-update-helper"


def elevate(verb: str) -> int:
    """Ask for the password rather than telling the user to go and find sudo.

    The same path serves the Update Centre and the command line, so a person
    sees one familiar prompt whichever they used. The nightly timer already
    runs as root and never reaches here -- an automatic update that stopped
    to ask for a password at 3am would simply never happen.
    """
    if not os.path.exists(HELPER):
        print("sakura-update apply must run as root", file=sys.stderr)
        return 1
    try:
        return subprocess.call(["pkexec", HELPER, verb])
    except FileNotFoundError:
        print("sakura-update apply must run as root", file=sys.stderr)
        return 1


@contextlib.contextmanager
def store_transaction_lock():
    """Serialise against the store, best effort.

    Advisory: if the lock cannot be taken the update still runs. An update
    that refuses to install security fixes because a lock file was missing
    would be a worse failure than the one this prevents.
    """
    lock = Path(os.environ.get("SAKURA_STORE_LOCK", "/run/sakura/store.lock"))
    fd = None
    try:
        lock.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(lock, os.O_CREAT | os.O_RDWR, 0o666)
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        if fd is not None:
            os.close(fd)
            fd = None
    try:
        yield
    finally:
        if fd is not None:
            os.close(fd)


def on_ac_power() -> bool:
    """Whether the machine is on mains power.

    A desktop with no battery reports nothing at all, and that has to read as
    "fine to update" rather than as "on battery" -- otherwise every desktop
    silently stops updating. Only an explicit "discharging" is a no.
    """
    supplies = Path("/sys/class/power_supply")
    if not supplies.is_dir():
        return True
    mains = []
    for d in supplies.iterdir():
        try:
            kind = (d / "type").read_text().strip()
        except OSError:
            continue
        if kind == "Mains":
            try:
                mains.append((d / "online").read_text().strip() == "1")
            except OSError:
                pass
    # No mains supply described at all: a desktop, or a kernel that does not
    # report it. Either way, not evidence of running on battery.
    return any(mains) if mains else True


def cmd_apply(args) -> int:
    if os.geteuid() != 0:
        # 126 and 127 are pkexec's own codes for "dismissed" and "not
        # authorised"; say so rather than leaving a bare number.
        # --unattended is deliberately not carried through the helper. It
        # accepts one argument from a fixed list precisely so that it cannot be
        # made to run something else, and the flag is not needed here: the
        # timer runs as root and never elevates. Anyone reaching this line is a
        # person who asked for updates, which is the case the settings do not
        # gate anyway.
        rc = elevate("apply")
        if rc in (126, 127):
            print("Updates were not installed: authentication was cancelled.",
                  file=sys.stderr)
        return rc

    cfg = read_config()

    # An unattended run is the timer's; a plain `apply` is somebody pressing
    # Install now. The settings describe what the machine does on its own, so
    # they gate the first and never the second -- a user who asks for updates
    # explicitly has already answered the question the setting exists to ask.
    if args.unattended:
        if cfg.get("AutoApply", "true") != "true":
            print("Automatic updates are switched off; nothing was installed.")
            return 0
        if cfg.get("RequireACPower", "true") == "true" and not on_ac_power():
            print("Not installing updates: this machine is on battery.")
            return 0

    ups = available()
    if not ups:
        print("Everything is up to date.")
        return 0

    describe(ups)
    holds = apply_holds(ups, cfg)
    ready = [u for u in ups if not u.held]

    if not ready:
        print("All updates are held back:")
        for title, pkgs in holds:
            print(f"  {pkgs}: {title}")
        return 0

    # The snapshot is what makes an unattended update defensible at all. If it
    # cannot be taken, do not proceed -- an automatic update with no way back
    # is the thing this whole design exists to avoid.
    if not snapshot(f"before installing {len(ready)} updates"):
        print("could not take a restore point; refusing to update", file=sys.stderr)
        return 1

    # The same lock the store takes. Without it an unattended update at 03:00
    # and an install a user started can reach pacman together; pacman's own
    # database lock stops them corrupting anything, but the loser fails with
    # "unable to lock database", which explains nothing. The store's docstring
    # already claimed this was shared -- it was not, until now.
    with store_transaction_lock():
        r = subprocess.run(["pacman", "-Syu", "--noconfirm"])
    if r.returncode != 0:
        return r.returncode

    if any(u.restart for u in ready):
        print("\nA restart is needed to finish.")
    return 0


def cmd_status(args) -> int:
    ups = available()
    if not ups:
        print("Up to date.")
    else:
        print(f"{len(ups)} update{'s' if len(ups) != 1 else ''} available.")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="sakura-update", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("check", help="what is available")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_check)

    a = sub.add_parser("apply", help="snapshot, then install")
    # The timer passes this; a person never does. It is what separates "the
    # machine decided to update" from "someone asked it to".
    a.add_argument("--unattended", action="store_true",
                   help="obey the automatic-update settings and skip if they say no")
    a.set_defaults(fn=cmd_apply)

    s = sub.add_parser("status", help="one line")
    s.set_defaults(fn=cmd_status)

    args = p.parse_args()
    STATE.mkdir(parents=True, exist_ok=True)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
