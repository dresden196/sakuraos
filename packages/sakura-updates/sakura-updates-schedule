#!/usr/bin/env python3
"""Make the update timer match the settings.

A timer cannot read a config file, so the one setting that has to reach
systemd -- when updates run -- is written into a drop-in and the units are
reloaded. AutoApply and RequireACPower are deliberately *not* handled here:
`sakura-update apply --unattended` reads those itself, so a stale unit can
never cause an update the settings said not to make.

Run as root, after /etc/sakura/sakura.conf changes and once at install.
"""
from __future__ import annotations

import configparser
import os
import re
import subprocess
import sys
from pathlib import Path

CONFIG = Path(os.environ.get("SAKURA_CONFIG", "/etc/sakura/sakura.conf"))
DROPIN = Path(os.environ.get("SAKURA_TIMER_DROPIN",
                             "/etc/systemd/system/sakura-updates.timer.d"))
# HH:MM, 24 hour. Anything else is not put in front of systemd.
WINDOW = re.compile(r"\A([01]\d|2[0-3]):([0-5]\d)\Z")


def window() -> str:
    cp = configparser.ConfigParser()
    try:
        cp.read(CONFIG)
    except configparser.Error:
        return "03:00"
    value = cp.get("Updates", "Window", fallback="03:00").strip()
    return value if WINDOW.match(value) else "03:00"


def main() -> int:
    if os.geteuid() != 0:
        print("must run as root", file=sys.stderr)
        return 1

    hhmm = window()
    DROPIN.mkdir(parents=True, exist_ok=True)
    (DROPIN / "schedule.conf").write_text(
        "# Written by sakura-updates-schedule from /etc/sakura/sakura.conf.\n"
        "# Edit the setting, not this file: it is regenerated on every change.\n"
        "[Timer]\n"
        # The empty assignment clears the unit's own OnCalendar first;
        # without it systemd adds a second schedule rather than replacing.
        "OnCalendar=\n"
        f"OnCalendar=*-*-* {hhmm}:00\n")

    subprocess.run(["systemctl", "daemon-reload"], check=False)
    # Enabling is idempotent, and doing it here means the timer is live on any
    # machine that has ever saved its update settings -- not only on ones
    # installed after the installer learned to enable it.
    subprocess.run(["systemctl", "enable", "--now", "sakura-updates.timer"],
                   check=False, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)
    print(f"update window: {hhmm}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
